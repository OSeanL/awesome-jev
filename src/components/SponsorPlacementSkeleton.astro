---
interface Props {
  placementKey: string;
  position: number;
}

const { placementKey, position } = Astro.props;
---

<article
  class="showcase-sponsor-placement sponsor-placement-skeleton"
  data-sponsor-placement
  data-sponsor-placement-key={placementKey}
  data-sponsor-position={position}
  aria-hidden="true"
>
  <span class="showcase-sponsor-visual sponsor-skeleton-visual">
    <span class="sponsor-skeleton-bar sponsor-skeleton-showcase-label"></span>
    <span class="sponsor-skeleton-bar sponsor-skeleton-showcase-logo"></span>
  </span>
  <span class="showcase-sponsor-body sponsor-skeleton-body">
    <span class="sponsor-skeleton-bar sponsor-skeleton-showcase-title"></span>
    <span class="sponsor-skeleton-bar sponsor-skeleton-showcase-domain"></span>
    <span class="showcase-sponsor-meta sponsor-skeleton-meta">
      <span class="sponsor-skeleton-bar sponsor-skeleton-showcase-amount"></span>
      <span class="sponsor-skeleton-bar sponsor-skeleton-showcase-action"></span>
    </span>
  </span>
</article>

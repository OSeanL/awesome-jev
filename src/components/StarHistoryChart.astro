---
interface Props {
  alt: string;
  className?: string;
}

const { alt, className } = Astro.props;
const starHistoryUrl = 'https://www.star-history.com/?repos=heyjunpenn%2Fawesome-jev&type=date&legend=bottom-right';
const darkChartUrl = `${import.meta.env.BASE_URL}api/star-history.png`;
---

<figure class:list={['hero-illustration', 'hero-star-history', className]}>
  <a href={starHistoryUrl} target="_blank" rel="noreferrer">
    <picture>
      <img
        src={darkChartUrl}
        alt={alt}
        width="800"
        height="533"
        loading="eager"
        decoding="async"
        fetchpriority="high"
      />
    </picture>
  </a>
</figure>

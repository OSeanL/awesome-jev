---
import { ArrowUpRight, Megaphone } from '@lucide/astro';
import type { Sponsor } from '../data/sponsors';
import type { Locale } from '../i18n';
import { getLocalePath } from '../i18n/config';

interface Props {
  locale: Locale;
  sponsors?: Sponsor[];
}

const { locale, sponsors = [] } = Astro.props;

const copy: Record<Locale, {
  heading: string;
  advertise: string;
  linkLabel: (name: string, rank: number) => string;
}> = {
  en: {
    heading: 'Sponsor',
    advertise: 'Advertise',
    linkLabel: (name, rank) => `Open sponsor #${rank}: ${name}`,
  },
  zh: {
    heading: '赞助',
    advertise: '推广',
    linkLabel: (name, rank) => `打开第 ${rank} 名赞助商：${name}`,
  },
  ja: {
    heading: '協賛',
    advertise: '掲載',
    linkLabel: (name, rank) => `スポンサー第${rank}位を開く：${name}`,
  },
  ko: {
    heading: '후원',
    advertise: '광고',
    linkLabel: (name, rank) => `${rank}위 스폰서 열기: ${name}`,
  },
  es: {
    heading: 'Apoyos',
    advertise: 'Anúnciate',
    linkLabel: (name, rank) => `Abrir patrocinador n.º ${rank}: ${name}`,
  },
  'pt-br': {
    heading: 'Apoios',
    advertise: 'Anuncie',
    linkLabel: (name, rank) => `Abrir patrocinador nº ${rank}: ${name}`,
  },
};

const text = copy[locale];
const base = import.meta.env.BASE_URL;
const advertiseHref = `${base}${getLocalePath(locale)}sponsors/`;
const endpoint = `${base}api/sponsors/`;
const clickEndpoint = `${base}api/sponsors/click/`;
const faviconUrl = (name: string, url: string) => name === 'blink.review'
  ? 'https://blink.review/icon.svg'
  : `${new URL(url).origin}/favicon.ico`;
---

<section class="sponsor-panel" aria-labelledby="sponsor-panel-title" data-sponsor-panel data-endpoint={endpoint} data-click-endpoint={clickEndpoint}>
  <div class="sponsor-panel-head">
    <div class="sponsor-panel-title" id="sponsor-panel-title"><Megaphone size={15} stroke-width={1.8} aria-hidden="true" /><span>{text.heading}</span></div>
    <a class="sponsor-cta" href={advertiseHref} title={text.advertise} aria-label={text.advertise}>
      <span>{text.advertise}</span>
      <ArrowUpRight size={13} stroke-width={1.9} aria-hidden="true" />
    </a>
  </div>

  <ol class="sponsor-list" data-sponsor-list hidden={sponsors.length === 0}>
    {sponsors.map((sponsor, index) => {
      const rank = index + 1;
      return (
        <li>
          <a
            href={`${sponsor.url}?utm_source=bestjev&utm_medium=sponsor&utm_campaign=sidebar`}
            title={text.linkLabel(sponsor.name, rank)}
            aria-label={text.linkLabel(sponsor.name, rank)}
            target="_blank"
            rel="sponsored noreferrer"
            data-sponsor-click-url={sponsor.url}
          >
            <span class:list={['sponsor-logo', `sponsor-logo-${sponsor.logoTone}`]} aria-hidden="true">
              <span>{sponsor.name.slice(0, 1).toUpperCase()}</span>
              <img src={sponsor.logoUrl ?? faviconUrl(sponsor.name, sponsor.url)} alt="" width="28" height="28" loading="lazy" decoding="async" />
            </span>
            <strong>#{rank}</strong>
            <span class="sponsor-name">{sponsor.name}</span>
          </a>
        </li>
      );
    })}
  </ol>

</section>

<script>
  type SponsorPayload = {
    sponsors: Array<{
      name: string;
      url: string;
      logoUrl?: string;
      logoTone: 'light' | 'dark';
    }>;
  };

  const faviconFor = (name: string, url: string) => name === 'blink.review'
    ? 'https://blink.review/icon.svg'
    : `${new URL(url).origin}/favicon.ico`;

  const trackingPanel = document.querySelector<HTMLElement>('[data-sponsor-panel]');
  const clickEndpoint = trackingPanel?.dataset.clickEndpoint;
  if (clickEndpoint && !document.documentElement.hasAttribute('data-sponsor-click-tracking')) {
    document.documentElement.setAttribute('data-sponsor-click-tracking', '');
    document.addEventListener('click', (event) => {
      if (event.defaultPrevented || !(event.target instanceof Element)) return;
      const link = event.target.closest<HTMLAnchorElement>('a[data-sponsor-click-url]');
      const sponsorUrl = link?.dataset.sponsorClickUrl;
      if (!sponsorUrl) return;

      const body = JSON.stringify({ url: sponsorUrl });
      const beacon = new Blob([body], { type: 'application/json' });
      if (navigator.sendBeacon?.(clickEndpoint, beacon)) return;
      void fetch(clickEndpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body,
        keepalive: true,
      }).catch(() => {});
    });
  }

  document.querySelectorAll<HTMLElement>('[data-sponsor-panel]').forEach(async (panel) => {
    const list = panel.querySelector<HTMLOListElement>('[data-sponsor-list]');
    const endpoint = panel.dataset.endpoint;
    if (!list || !endpoint) return;

    try {
      const response = await fetch(endpoint, {
        headers: { Accept: 'application/json' },
        cache: 'no-store',
      });
      if (!response.ok) return;
      const payload = await response.json() as SponsorPayload;
      const sponsors = payload.sponsors.slice(0, 3);
      list.hidden = sponsors.length === 0;

      list.replaceChildren(...sponsors.map((sponsor, index) => {
        const rank = index + 1;
        const item = document.createElement('li');
        const link = document.createElement('a');
        link.href = `${sponsor.url}?utm_source=bestjev&utm_medium=sponsor&utm_campaign=sidebar`;
        link.target = '_blank';
        link.rel = 'sponsored noreferrer';
        link.ariaLabel = `Sponsor #${rank}: ${sponsor.name}`;
        link.dataset.sponsorClickUrl = sponsor.url;

        const logo = document.createElement('span');
        logo.className = `sponsor-logo sponsor-logo-${sponsor.logoTone}`;
        logo.ariaHidden = 'true';
        const fallback = document.createElement('span');
        fallback.textContent = sponsor.name.slice(0, 1).toUpperCase();
        const image = document.createElement('img');
        image.src = sponsor.logoUrl ?? faviconFor(sponsor.name, sponsor.url);
        image.alt = '';
        image.width = 28;
        image.height = 28;
        image.decoding = 'async';
        logo.appendChild(fallback);
        logo.appendChild(image);

        const rankLabel = document.createElement('strong');
        rankLabel.textContent = `#${rank}`;
        const name = document.createElement('span');
        name.className = 'sponsor-name';
        name.textContent = sponsor.name;
        link.appendChild(logo);
        link.appendChild(rankLabel);
        link.appendChild(name);
        item.appendChild(link);
        return item;
      }));
    } catch {
      // The prerendered sponsor list remains available when the Worker is unreachable.
    }
  });
</script>

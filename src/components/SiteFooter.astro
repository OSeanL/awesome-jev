---
import { getMessages, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const base = import.meta.env.BASE_URL;
const copy = getMessages(locale).footer;
---

<footer class="site-footer">
  <span>bestjev / 2026</span>
  <nav aria-label={copy.label}>
    <a href={`${base}about/`} title={copy.about}>{copy.about}</a>
    <a href="mailto:someuxyz@gmail.com" title={copy.contact}>{copy.contact}</a>
    <a href={`${base}privacy/`} title={copy.privacy}>{copy.privacy}</a>
    <a href={`${base}terms/`} title={copy.terms}>{copy.terms}</a>
    <a href={`${base}llms.txt`} title="LLMs.txt">llms.txt</a>
    <a href={`${base}llms-full.txt`} title="LLMs Full.txt">llms-full.txt</a>
    <a href="https://docs.typesafe.ai/" title={copy.docs} target="_blank" rel="noreferrer"><span>{copy.docs}</span> ↗</a>
  </nav>
</footer>

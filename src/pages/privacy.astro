---
import '../styles/global.css';
const title = 'Privacy | bestjev';
const description = 'How bestjev handles analytics, messages, and external links.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://jevbest.com/privacy/" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class="policy-body">
    <main class="policy-page">
      <a class="policy-back" href="/" title="Back to bestjev">← bestjev</a>
      <p class="section-kicker">SITE INFORMATION</p>
      <h1>Privacy</h1>
      <p class="policy-updated">Last updated September 20, 2026</p>
      <h2>What does this site collect?</h2>
      <p>bestjev uses Google Analytics and DataFast to understand aggregate site usage, such as page visits, device type, and referring pages. These providers may set cookies or process technical identifiers according to their own policies. The catalog does not provide user accounts or sell personal information.</p>
      <h2>What happens when you contact us?</h2>
      <p>If you email the maintainer or submit a GitHub issue, the information you provide is used to respond to the message or review the submission. GitHub and your email provider process that information under their own terms.</p>
      <h2>External links</h2>
      <p>The catalog links to third-party repositories and websites. Their privacy practices are outside bestjev’s control, so review the destination’s policies before sharing personal information.</p>
      <h2>Contact</h2>
      <p>Questions about this notice can be sent to <a href="mailto:someuxyz@gmail.com" title="Email bestjev">someuxyz@gmail.com</a>.</p>
    </main>
  </body>
</html>

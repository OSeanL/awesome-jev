---
import CatalogPage from '../index.astro';
import { getCatalog } from '../../lib/catalog';
import { defaultLocale } from '../../i18n';

export const getStaticPaths = () => {
  const filters = ['today', 'this-week', ...getCatalog(defaultLocale).categories.map((category) => category.id)];
  return filters.map((filter) => ({ params: { filter }, props: { filter } }));
};

const { filter } = Astro.props;
---

<CatalogPage filter={filter} />

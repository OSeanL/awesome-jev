---
import ShowcasePage from '../../showcase.astro';
import { defaultLocale, locales } from '../../../i18n';
import { showcaseRouteSlugs } from '../../../i18n/showcase';

export const getStaticPaths = () => locales
  .filter((locale) => locale !== defaultLocale)
  .flatMap((locale) => showcaseRouteSlugs.map((filter) => ({
    params: { locale, category: filter },
    props: { locale, filter },
  })));

const { locale, filter } = Astro.props;
---

<ShowcasePage locale={locale} filter={filter} />

---
import '../styles/global.css';
const title = 'Terms | Awesome Jev';
const description = 'Terms for using the independent Awesome Jev community catalog.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://jevbest.com/terms/" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="512x512" href="/favicon.png" />
    <link rel="apple-touch-icon" href="/favicon.png" />
    <title>{title}</title>
  </head>
  <body class="policy-body">
    <main class="policy-page">
      <a class="policy-back" href="/">← Awesome Jev</a>
      <p class="section-kicker">SITE INFORMATION</p>
      <h1>Terms</h1>
      <p class="policy-updated">Last updated September 19, 2026</p>
      <h2>Independent catalog</h2>
      <p>Awesome Jev is an independent community catalog. It is not affiliated with, sponsored by, or endorsed by TypeSafe AI. Product names and trademarks belong to their respective owners.</p>
      <h2>Accuracy and availability</h2>
      <p>Entries are assembled from public evidence and may become outdated. Star counts are dated snapshots. Verify behavior, security, licensing, and maintenance status with each upstream project before relying on it.</p>
      <h2>Linked projects</h2>
      <p>Awesome Jev does not operate or warrant third-party repositories and websites. Each linked project remains subject to its own license and terms.</p>
      <h2>Contact</h2>
      <p>Corrections and removal requests can be submitted through the <a href="https://github.com/heyjunpenn/awesome-jev/issues">GitHub issue tracker</a> or sent to <a href="mailto:someuxyz@gmail.com">someuxyz@gmail.com</a>.</p>
    </main>
  </body>
</html>

---
import '../styles/global.css';
const title = 'Terms | bestjev';
const description = 'Terms for using the independent bestjev community catalog.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <link rel="canonical" href="https://jevbest.com/terms/" />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href="/favicon.ico" />
    <link rel="icon" type="image/png" sizes="96x96" href="/favicon-96x96.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <title>{title}</title>
  </head>
  <body class="policy-body">
    <main class="policy-page">
      <a class="policy-back" href="/" title="Back to bestjev">← bestjev</a>
      <p class="section-kicker">SITE INFORMATION</p>
      <h1>Terms</h1>
      <p class="policy-updated">Last updated September 19, 2026</p>
      <h2>Independent catalog</h2>
      <p>bestjev is an independent community catalog. It is not affiliated with, sponsored by, or endorsed by TypeSafe AI. Product names and trademarks belong to their respective owners.</p>
      <h2>Accuracy and availability</h2>
      <p>Entries are assembled from public evidence and may become outdated. Star counts are dated snapshots. Verify behavior, security, licensing, and maintenance status with each upstream project before relying on it.</p>
      <h2>Linked projects</h2>
      <p>bestjev does not operate or warrant third-party repositories and websites. Each linked project remains subject to its own license and terms.</p>
      <h2>Contact</h2>
      <p>Corrections and removal requests can be submitted through the <a href="https://github.com/heyjunpenn/awesome-jev/issues" title="GitHub issue tracker">GitHub issue tracker</a> or sent to <a href="mailto:someuxyz@gmail.com" title="Email bestjev">someuxyz@gmail.com</a>.</p>
    </main>
  </body>
</html>

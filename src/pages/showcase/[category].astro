---
import ShowcasePage from '../showcase.astro';
import { showcaseRouteSlugs } from '../../i18n/showcase';

export const getStaticPaths = () => showcaseRouteSlugs.map((filter) => ({
  params: { category: filter },
  props: { filter },
}));

const { filter } = Astro.props;
---

<ShowcasePage filter={filter} />

---
import '../styles/global.css';
import '../styles/sponsor-placements.css';
import SearchFilterPanel from '../components/SearchFilterPanel.astro';
import RealtimeTraffic from '../components/RealtimeTraffic.astro';
import SiteHero from '../components/SiteHero.astro';
import SiteLayout from '../components/SiteLayout.astro';
import SponsorPlacements from '../components/SponsorPlacements.astro';
import StarHistoryChart from '../components/StarHistoryChart.astro';
import { catalogStats, getCatalog } from '../lib/catalog';
import { defaultLocale, getLocale, getMessages, localeConfig, locales, type Locale } from '../i18n';
import { getCategoryGuide } from '../i18n/category-guides';
import { getLocalePath } from '../i18n/config';
import {
  ArrowDown,
  ArrowUpRight,
  Check,
  ChevronDown,
  CirclePlus,
  Star,
} from '@lucide/astro';

const base = import.meta.env.BASE_URL;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const messages = getMessages(locale);
const { categories, projects } = getCatalog(locale);
const validFilters = new Set(['all', 'today', 'this-week', ...categories.map((category) => category.id)]);
const requestedFilter = typeof Astro.props.filter === 'string' ? Astro.props.filter : 'all';
const activeFilter = validFilters.has(requestedFilter) ? requestedFilter : 'all';
const filterHref = (filter: string, targetLocale: Locale = locale) =>
  `${base}${getLocalePath(targetLocale)}${filter === 'all' ? '' : `projects/${filter}/`}`;
const filterPath = (filter: string, targetLocale: Locale = locale) =>
  `${getLocalePath(targetLocale)}${filter === 'all' ? '' : `projects/${filter}/`}`;
const pageProjects = projects.filter((project) => {
  if (activeFilter === 'all') return true;
  if (activeFilter === 'today') return project.addedDate === catalogStats.today;
  if (activeFilter === 'this-week') return project.addedDate >= catalogStats.weekStartsOn && project.addedDate <= catalogStats.today;
  return project.categoryId === activeFilter;
});
const addedDateFormatter = new Intl.DateTimeFormat(localeConfig[locale].languageTag, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Taipei' });
const formatAddedDate = (date: string) => addedDateFormatter.format(new Date(`${date}T00:00:00+08:00`));
const repositoryUrl = process.env.GITHUB_REPOSITORY
  ? `https://github.com/${process.env.GITHUB_REPOSITORY}`
  : 'https://github.com/heyjunpenn/awesome-jev';
const submissionIssueBody = [
  '## Project',
  '- Repository URL:',
  '- Short description:',
  '',
  '## Jev usage',
  '- Evidence link (code, docs, or demo):',
  '- How does this project use Jev?',
].join('\n');
const submissionUrl = `${repositoryUrl}/issues/new?title=${encodeURIComponent('[Submission] Project name')}&body=${encodeURIComponent(submissionIssueBody)}`;
const languages = [...new Set(projects.map((project) => project.language).filter((language) => language !== '—'))]
  .sort((a, b) => a.localeCompare(b));
const sortedProjects = [...pageProjects].sort((a, b) => {
  const starDifference = b.stars - a.stars;
  return starDifference || a.url.localeCompare(b.url, 'en');
});
const localizedSearchText = (project: (typeof projects)[number]) =>
  [project.name, project.url, project.language, project.description].join(' ').toLowerCase();
const jevLikeCategoryId = 'jev-like-models';
const jevLikeCategory = categories.find((category) => category.id === jevLikeCategoryId);
const filterCategories = categories.filter((category) => category.id !== jevLikeCategoryId);
const catalogFilterOptions = [
  { id: 'all', label: messages.catalog.all, count: projects.length, countLabel: String(projects.length) },
  ...(jevLikeCategory ? [{ id: jevLikeCategory.id, label: jevLikeCategory.name, count: jevLikeCategory.count, countLabel: String(jevLikeCategory.count) }] : []),
  { id: 'today', label: messages.hero.addedToday, count: catalogStats.addedToday, countLabel: `+${catalogStats.addedToday}` },
  { id: 'this-week', label: messages.hero.addedThisWeek, count: catalogStats.addedThisWeek, countLabel: `+${catalogStats.addedThisWeek}` },
  ...filterCategories.map((category) => ({ id: category.id, label: category.name, count: category.count, countLabel: String(category.count) })),
];
const activeCatalogFilter = catalogFilterOptions.find((filter) => filter.id === activeFilter) ?? catalogFilterOptions[0];
const repositorySlug = (url: string) => {
  try {
    const [owner, repository] = new URL(url).pathname.split('/').filter(Boolean);
    return owner && repository ? `${owner}/${repository.replace(/\.git$/, '')}` : url;
  } catch {
    return url;
  }
};
const siteUrl = 'https://jevbest.com/';
const pageUrl = `${siteUrl}${filterPath(activeFilter)}`;
const socialImageUrl = `${siteUrl}readme/awesome-jev-hero.png`;
const authorId = `${siteUrl}#author`;
const publisherId = `${siteUrl}#organization`;
const catalogId = `${siteUrl}#catalog`;
const datasetId = `${siteUrl}#projects`;
const activeCategory = categories.find((category) => category.id === activeFilter);
const activeCategoryName = activeCategory?.name.trim();
const categoryGuide = activeCategory && activeCategoryName ? getCategoryGuide(locale, activeCategory.id, activeCategoryName) : undefined;
const showEditorialSections = activeFilter === 'all' || activeFilter === 'today' || activeFilter === 'this-week';
const heroTitle = activeFilter === 'today'
  ? messages.filterPage.todayTitle
  : activeFilter === 'this-week'
    ? messages.filterPage.weekTitle
    : activeCategoryName
      ? messages.filterPage.categoryTitle(activeCategoryName)
      : messages.hero.title;
const heroSummary = activeFilter === 'today'
  ? messages.filterPage.todayDescription(pageProjects.length)
  : activeFilter === 'this-week'
    ? messages.filterPage.weekDescription(pageProjects.length)
    : activeCategoryName
      ? messages.filterPage.categoryDescription(pageProjects.length, activeCategoryName)
      : messages.hero.summary(catalogStats.projects, catalogStats.categories, catalogStats.languages);
const catalogPageTitle = messages.seo.title(catalogStats.projects);
const pageTitle = activeFilter === 'today'
  ? messages.filterPage.todaySeoTitle
  : activeFilter === 'this-week'
    ? messages.filterPage.weekSeoTitle
    : activeCategoryName
      ? messages.filterPage.categorySeoTitle(activeCategoryName)
      : catalogPageTitle;
const pageDescription = activeFilter === 'all' ? messages.seo.description(catalogStats.projects) : heroSummary;
const coreSeoKeywords = ['bestjev', 'Jev projects', 'open source Jev', 'Jev GitHub projects', 'TypeSafe AI Jev'];
const pageKeywords = activeFilter === 'today'
  ? ['new Jev projects today', 'latest open source Jev projects', ...coreSeoKeywords]
  : activeFilter === 'this-week'
    ? ['new Jev projects this week', 'weekly open source Jev projects', ...coreSeoKeywords]
    : activeCategoryName
      ? [`awesome ${activeCategoryName} Jev projects`, `${activeCategoryName} Jev projects`, `open source ${activeCategoryName}`, `bestjev ${activeCategoryName}`, ...coreSeoKeywords]
      : ['Jev open source projects', 'awesome open source Jev projects', 'Jev SDK', 'Jev agents', 'Jev integrations', 'Jev developer tools', ...coreSeoKeywords];
const alternateLocales = locales.filter((candidate) => candidate !== locale);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': publisherId,
      name: 'bestjev',
      alternateName: 'bestjev open-source Jev catalog',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}favicon.png`,
        width: 512,
        height: 512,
      },
      sameAs: [repositoryUrl, 'https://x.com/heyjunpenn'],
    },
    {
      '@type': 'Person',
      '@id': authorId,
      name: 'heyjunpenn',
      url: 'https://github.com/heyjunpenn',
      sameAs: ['https://github.com/heyjunpenn', 'https://x.com/heyjunpenn'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'bestjev',
      alternateName: 'bestjev Jev Project Catalog',
      description: pageDescription,
      inLanguage: locales.map((candidate) => localeConfig[candidate].languageTag),
      publisher: { '@id': publisherId },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: heroTitle,
      alternateName: messages.seo.alternateName,
      description: pageDescription,
      isAccessibleForFree: true,
      inLanguage: localeConfig[locale].languageTag,
      dateModified: '2026-09-20',
      datePublished: '2026-09-19',
      author: { '@id': authorId },
      publisher: { '@id': publisherId },
      isPartOf: { '@id': `${siteUrl}#website` },
      keywords: pageKeywords,
      about: {
        '@type': 'SoftwareApplication',
        name: 'Jev',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Cloud API',
        url: 'https://typesafe.ai/',
      },
      mainEntity: { '@id': datasetId },
    },
    {
      '@type': 'DataCatalog',
      '@id': catalogId,
      name: 'bestjev Open-Source Project Catalog',
      alternateName: 'bestjev Jev Project Catalog',
      description: pageDescription,
      url: siteUrl,
      inLanguage: locales.map((candidate) => localeConfig[candidate].languageTag),
      publisher: { '@id': publisherId },
      dataset: { '@id': datasetId },
    },
    {
      '@type': 'Dataset',
      '@id': datasetId,
      name: 'bestjev Open-Source Project Dataset',
      alternateName: 'bestjev Jev Project Dataset',
      description: `Machine-readable metadata for ${catalogStats.projects} public repositories built around Jev.`,
      url: siteUrl,
      identifier: datasetId,
      keywords: ['Jev', 'open-source projects', 'SDKs', 'agents', 'integrations', 'developer tools'],
      license: 'https://opensource.org/license/mit',
      isAccessibleForFree: true,
      inLanguage: locales.map((candidate) => localeConfig[candidate].languageTag),
      dateModified: '2026-09-20',
      datePublished: '2026-09-19',
      creator: { '@id': authorId },
      publisher: { '@id': publisherId },
      version: '2026-09-20',
      includedInDataCatalog: {
        '@type': 'DataCatalog',
        '@id': catalogId,
        name: 'bestjev Open-Source Project Catalog',
        url: siteUrl,
      },
      distribution: {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: `${siteUrl}catalog.json`,
      },
    },
    ...(categoryGuide ? [{
      '@type': 'FAQPage',
      '@id': `${pageUrl}#faq`,
      url: `${pageUrl}#category-faq`,
      inLanguage: localeConfig[locale].languageTag,
      mainEntity: categoryGuide.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }] : []),
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
const initialProjectLimit = 16;
---

<!doctype html>
<html lang={localeConfig[locale].languageTag} data-language={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <style is:inline>@media (max-width: 1080px) { .sidebar { visibility: hidden; transform: translateX(-102%); } body.menu-open .sidebar { visibility: visible; transform: translateX(0); } }</style>
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords.join(', ')} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="heyjunpenn" />
    <link rel="canonical" href={pageUrl} />
    {locales.map((candidate) => <link rel="alternate" hreflang={localeConfig[candidate].languageTag} href={`${siteUrl}${filterPath(activeFilter, candidate)}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${filterPath(activeFilter, defaultLocale)}`} />
    <link rel="alternate" type="application/json" title="bestjev project catalog" href={`${siteUrl}catalog.json`} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bestjev" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={localeConfig[locale].openGraphLocale} />
    {alternateLocales.map((candidate) => <meta property="og:locale:alternate" content={localeConfig[candidate].openGraphLocale} />)}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1983" />
    <meta property="og:image:height" content="793" />
    <meta property="og:image:alt" content={messages.seo.imageAlt(catalogStats.projects, catalogStats.categories)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heyjunpenn" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={messages.seo.imageAlt(catalogStats.projects, catalogStats.categories)} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
    <script is:inline>
      (() => {
        const events = ['pointerdown', 'keydown', 'touchstart'];
        const loadAnalytics = () => {
          events.forEach((event) => window.removeEventListener(event, loadAnalytics));
          if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;

          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-HV69G90WGD');

          const googleTag = document.createElement('script');
          googleTag.async = true;
          googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=G-HV69G90WGD';
          document.head.append(googleTag);

          const dataFast = document.createElement('script');
          dataFast.defer = true;
          dataFast.dataset.websiteId = 'dfid_lVw0uw28br7SqwvICIeFq';
          dataFast.dataset.domain = 'jevbest.com';
          dataFast.src = 'https://datafa.st/js/script.js';
          document.head.append(dataFast);
        };

        events.forEach((event) => window.addEventListener(event, loadAnalytics, { once: true, passive: true }));
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="app-shell">
      <SiteLayout locale={locale} activeFilter={activeFilter}>

        <SiteHero title={heroTitle} summary={heroSummary} filtered={activeFilter !== 'all'}>
          <Fragment slot="copy-extra">
              <div class="hero-updated"><span>{messages.hero.lastUpdated}</span><time datetime="2026-09-22">{messages.hero.updatedDate}</time></div>
              <div class="recency-filters" role="group" aria-label={messages.hero.clearRecency} data-today={catalogStats.today} data-week-start={catalogStats.weekStartsOn}>
                {jevLikeCategory && (
                  <a href={filterHref(jevLikeCategory.id)} title={jevLikeCategory.name} aria-current={activeFilter === jevLikeCategory.id ? 'page' : undefined}>
                    <span>{jevLikeCategory.name}</span><strong>{jevLikeCategory.count}</strong>
                  </a>
                )}
                <a href={filterHref('today')} title={messages.hero.addedToday} aria-current={activeFilter === 'today' ? 'page' : undefined}>
                  <span>{messages.hero.addedToday}</span><strong>+{catalogStats.addedToday}</strong>
                </a>
                <a href={filterHref('this-week')} title={messages.hero.addedThisWeek} aria-current={activeFilter === 'this-week' ? 'page' : undefined}>
                  <span>{messages.hero.addedThisWeek}</span><strong>+{catalogStats.addedThisWeek}</strong>
                </a>
              </div>
              <SearchFilterPanel searchId="project-search" placeholder={messages.hero.searchPlaceholder} hasAction>
                <div class="language-picker" data-language-picker slot="picker">
                  <button class="language-trigger" id="language-filter" type="button" aria-label={messages.hero.filterLanguage} aria-haspopup="listbox" aria-expanded="false" aria-controls="language-options">
                    <span data-language-label>{messages.hero.allLanguages}</span>
                    <ChevronDown class="language-chevron" size={15} stroke-width={1.8} aria-hidden="true" />
                  </button>
                  <div class="language-menu" id="language-options" role="listbox" aria-label={messages.hero.languages} hidden>
                    <button class="language-option" type="button" role="option" data-language-value="all" aria-selected="true">
                      <span>{messages.hero.allLanguages}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                    </button>
                    {languages.map((language) => (
                      <button class="language-option" type="button" role="option" data-language-value={language} aria-selected="false">
                        <span>{language}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                      </button>
                    ))}
                  </div>
                </div>
                <a class="submit-project-shortcut" slot="action" href={submissionUrl} title={messages.submission.shortCta} target="_blank" rel="noreferrer">
                  <CirclePlus size={17} stroke-width={1.9} aria-hidden="true" />
                  <span>{messages.submission.shortCta}</span>
                </a>
              </SearchFilterPanel>
          </Fragment>
          <Fragment slot="visual">
            <StarHistoryChart alt={messages.hero.imageAlt} />
            <RealtimeTraffic />
          </Fragment>
        </SiteHero>

        <div class="catalog-region">
          <section class="catalog" id="projects">
            <div class="category-strip" role="group" aria-label={messages.nav.projectCategories}>
              {catalogFilterOptions.map((filter, index) => (
                <>
                  {filter.id === activeCatalogFilter.id ? (
                  <h2 class="category-filter-heading">
                    <a class="category-button selected" href={filterHref(filter.id)} title={filter.label} aria-current="page"><span>{filter.label}</span><b>{filter.countLabel}</b></a>
                  </h2>
                  ) : (
                    <a class="category-button" href={filterHref(filter.id)} title={filter.label}><span>{filter.label}</span><b>{filter.countLabel}</b></a>
                  )}
                  {(index === 1 || index === 3) && <span class="filter-divider" aria-hidden="true"></span>}
                </>
              ))}
            </div>

            <div class="table-heading">
              <span>{messages.catalog.project}</span>
              <span class="star-heading">
                <button
                  class="sort-button"
                  id="star-sort"
                  type="button"
                  data-direction="desc"
                  data-label-ascending={messages.catalog.sortAscending}
                  data-label-descending={messages.catalog.sortDescending}
                  aria-label={messages.catalog.sortAscending}
                >{messages.catalog.stars}<ArrowDown size={13} stroke-width={1.9} aria-hidden="true" /></button>
              </span>
              <span>{messages.catalog.language}</span>
              <span>{messages.catalog.addedAt}</span>
              <span>{messages.catalog.description}</span>
            </div>
            <ol class="project-table" id="project-table" aria-label={messages.catalog.projectsLabel}>
              {sortedProjects.map((project, index) => (
                <li class="project-row" data-project data-stars={project.stars} data-category={project.categoryId} data-language={project.language} data-search={localizedSearchText(project)} data-added-date={project.addedDate} hidden={index >= initialProjectLimit}>
                  <a class="project-name" href={project.url} title={repositorySlug(project.url)} target="_blank" rel="noreferrer"><h3>{repositorySlug(project.url)}</h3><small>{project.category}</small></a>
                  <span class="stars"><Star class="star-icon" size={13} stroke-width={1.8} aria-hidden="true" />{project.starsLabel}</span>
                  <span class="project-language">{project.language}</span>
                  <time class="project-added-date" datetime={project.addedDate}>{formatAddedDate(project.addedDate)}</time>
                  <p>{project.description}</p>
                </li>
              ))}
            </ol>
            <SponsorPlacements locale={locale} surface="projects" />

            <div class="empty-state" id="empty-state" hidden><strong>{messages.catalog.noMatches}</strong><span>{messages.catalog.noMatchesHint}</span></div>
            <button class="load-more" id="load-more" type="button"><span>{messages.catalog.showMore}</span><b>↓</b></button>
          </section>
        </div>

        {categoryGuide && (
          <section class="category-guide" id="category-guide">
            <div class="category-guide-intro">
              <span>{categoryGuide.eyebrow}</span>
              <h2>{categoryGuide.title}</h2>
              <p>{categoryGuide.intro}</p>
              <p>{categoryGuide.scope}</p>
            </div>
            <div class="category-faq" id="category-faq">
              <h2>{categoryGuide.faqTitle}</h2>
              <div class="category-faq-list">
                {categoryGuide.faqs.map((faq) => (
                  <article>
                    <h3>{faq.question}</h3>
                    <p>{faq.answer}</p>
                  </article>
                ))}
              </div>
            </div>
            <div class="category-sources">
              <h2>{categoryGuide.sourceTitle}</h2>
              <p>
                {categoryGuide.sourceIntro}{' '}
                <a href="https://docs.typesafe.ai/" title={messages.methodology.officialDocs} target="_blank" rel="noreferrer">{messages.methodology.officialDocs}</a>
                {' · '}
                <a href={repositoryUrl} title={messages.methodology.repositories} target="_blank" rel="noreferrer">{messages.methodology.repositories}</a>.
              </p>
              <blockquote cite="https://typesafe.ai/">
                <span>“Typed outputs that software can act on.”</span>
                <cite>— <a href="https://typesafe.ai/" title="TypeSafe AI on Jev" target="_blank" rel="noreferrer">TypeSafe AI</a></cite>
              </blockquote>
            </div>
          </section>
        )}

        {showEditorialSections && (<>
        <section class="site-intro" id="about-bestjev">
          <div class="site-intro-heading">
            <span>{messages.siteIntro.eyebrow}</span>
            <h2>{messages.siteIntro.title}</h2>
          </div>
          <div class="site-intro-copy">
            {messages.siteIntro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="about" id="about">
          <div class="about-intro">
            <h2>{messages.about.title}</h2>
            <div class="about-copy">
              {messages.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div class="about-note">
              <span>{messages.about.advantage}</span>
              <p>{messages.about.advantageText}</p>
            </div>
          </div>
          <div class="primitive-grid">
            {messages.about.primitives.map((primitive) => <article><span>{primitive.code}</span><h3>{primitive.title}</h3><p>{primitive.description}</p></article>)}
          </div>
        </section>

        <section class="methodology" id="methodology">
          <div>
            <h2>{messages.methodology.title}</h2>
          </div>
          <div class="methodology-copy">
            <p>{messages.methodology.intro}</p>
            <p class="catalog-byline"><span>{messages.methodology.curatedBy}</span> <a href="https://github.com/heyjunpenn" title="heyjunpenn" rel="author">heyjunpenn</a></p>
            <blockquote cite="https://typesafe.ai/blog/introducing-system-one-models-and-jev">
              <span>{messages.methodology.quote}</span>
              <cite>— <a href="https://typesafe.ai/blog/introducing-system-one-models-and-jev" title={messages.methodology.quoteSource} target="_blank" rel="noreferrer">{messages.methodology.quoteSource}</a></cite>
            </blockquote>
            <h3>{messages.methodology.sourcesTitle}</h3>
            <ul>
              <li><a href="https://docs.typesafe.ai/" title={messages.methodology.officialDocs} target="_blank" rel="noreferrer">{messages.methodology.officialDocs}</a>{messages.methodology.officialDocsSuffix}</li>
              <li><a href={repositoryUrl} title={messages.methodology.repositories} target="_blank" rel="noreferrer">{messages.methodology.repositories}</a>{messages.methodology.repositoriesSuffix}</li>
              <li><a href={`${siteUrl}catalog.json`} title={messages.methodology.catalogData}>{messages.methodology.catalogData}</a>{messages.methodology.catalogDataSuffix}</li>
            </ul>
          </div>
        </section>

        <section class="submission" id="submit-project">
          <div class="submission-heading">
            <span>{messages.submission.eyebrow}</span>
            <h2>{messages.submission.title}</h2>
            <p>{messages.submission.intro}</p>
            <a class="submission-cta" href={submissionUrl} title={messages.submission.cta} target="_blank" rel="noreferrer">
              <CirclePlus size={18} stroke-width={1.9} aria-hidden="true" />
              <span>{messages.submission.cta}</span>
              <ArrowUpRight size={16} stroke-width={1.9} aria-hidden="true" />
            </a>
            <small>{messages.submission.ctaHint}</small>
          </div>
          <ol class="submission-steps">
            {messages.submission.steps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{step.title}</h3><p>{step.description}</p></div>
              </li>
            ))}
          </ol>
        </section>
        </>)}

      </SiteLayout>
    </div>

    <script>
      type ProjectRowRecord = {
        element: HTMLElement;
        name: string;
        stars: number;
        language: string;
        searchText: string;
      };

      const search = document.querySelector<HTMLInputElement>('#project-search');
      const languagePicker = document.querySelector<HTMLElement>('[data-language-picker]');
      const languageFilter = document.querySelector<HTMLButtonElement>('#language-filter');
      const languageMenu = document.querySelector<HTMLElement>('#language-options');
      const languageLabel = document.querySelector<HTMLElement>('[data-language-label]');
      const languageOptions = [...document.querySelectorAll<HTMLButtonElement>('[data-language-value]')];
      const localePicker = document.querySelector<HTMLElement>('[data-locale-picker]');
      const localeTrigger = localePicker?.querySelector<HTMLButtonElement>('.locale-trigger');
      const localeMenu = localePicker?.querySelector<HTMLElement>('.locale-menu');
      const localeOptions = [...(localePicker?.querySelectorAll<HTMLAnchorElement>('.locale-option') ?? [])];
      const projectTable = document.querySelector<HTMLOListElement>('#project-table');
      const starSort = document.querySelector<HTMLButtonElement>('#star-sort');
      const loadMore = document.querySelector('#load-more');
      const emptyState = document.querySelector('#empty-state');
      const menuButton = document.querySelector('.menu-button');
      const sidebarClose = document.querySelector('.sidebar-close');
      const navScrim = document.querySelector('.nav-scrim');
      const sidebar = document.querySelector('#sidebar');
      const compactLayout = window.matchMedia('(max-width: 1080px)');
      const getPageSize = () => compactLayout.matches ? 16 : 36;
      let selectedLanguage = 'all';
      let starSortDirection: 'asc' | 'desc' = 'desc';
      let visibleLimit = getPageSize();

      let projectRecords = [...document.querySelectorAll<HTMLElement>('[data-project]')].map((row): ProjectRowRecord => ({
        element: row,
        name: row.querySelector('h3')?.textContent ?? '',
        stars: Number(row.dataset.stars ?? 0),
        language: row.dataset.language ?? '—',
        searchText: row.dataset.search ?? '',
      }));
      const updateSortState = () => {
        starSort?.setAttribute('data-direction', starSortDirection);
        if (starSort) {
          starSort.setAttribute('aria-label', starSortDirection === 'desc'
            ? starSort.dataset.labelAscending ?? ''
            : starSort.dataset.labelDescending ?? '');
        }
      };

      const render = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const matches = [...projectRecords].sort((a, b) => {
          const difference = a.stars - b.stars;
          if (difference !== 0) return starSortDirection === 'desc' ? -difference : difference;
          return a.name.localeCompare(b.name, 'en');
        }).filter((project) => {
          const languageMatch = selectedLanguage === 'all' || project.language === selectedLanguage;
          const searchMatch = !query || project.searchText.includes(query);
          return languageMatch && searchMatch;
        });

        const visibleProjects = new Set(matches.slice(0, visibleLimit));
        const fragment = document.createDocumentFragment();
        projectRecords
          .sort((a, b) => {
            const difference = a.stars - b.stars;
            if (difference !== 0) return starSortDirection === 'desc' ? -difference : difference;
            return a.name.localeCompare(b.name, 'en');
          })
          .forEach((project) => {
            project.element.hidden = !visibleProjects.has(project);
            fragment.append(project.element);
        });
        projectTable?.replaceChildren(fragment);
        if (loadMore instanceof HTMLButtonElement) loadMore.hidden = matches.length <= visibleLimit;
        if (emptyState instanceof HTMLElement) emptyState.hidden = matches.length !== 0;
        window.dispatchEvent(new CustomEvent('catalog:rendered'));
      };

      const setLanguageMenuOpen = (open: boolean, focusOption = false) => {
        if (!(languageFilter instanceof HTMLButtonElement) || !(languageMenu instanceof HTMLElement)) return;
        languageFilter.setAttribute('aria-expanded', String(open));
        languageMenu.hidden = !open;
        if (open && focusOption) {
          (languageOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? languageOptions[0])?.focus();
        }
      };

      const selectLanguage = (option: HTMLButtonElement) => {
        selectedLanguage = option.dataset.languageValue ?? 'all';
        if (languageLabel) languageLabel.textContent = option.querySelector('span')?.textContent ?? option.textContent?.trim() ?? '';
        languageOptions.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
        visibleLimit = getPageSize();
        setLanguageMenuOpen(false);
        render();
        languageFilter?.focus();
      };

      const setLocaleMenuOpen = (open: boolean, focusOption = false) => {
        if (!(localeTrigger instanceof HTMLButtonElement) || !(localeMenu instanceof HTMLElement)) return;
        localeTrigger.setAttribute('aria-expanded', String(open));
        localeMenu.hidden = !open;
        if (open && focusOption) {
          (localeOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? localeOptions[0])?.focus();
        }
      };

      search?.addEventListener('input', () => { visibleLimit = getPageSize(); render(); });
      starSort?.addEventListener('click', () => {
        starSortDirection = starSortDirection === 'desc' ? 'asc' : 'desc';
        visibleLimit = getPageSize();
        updateSortState();
        render();
      });
      languageFilter?.addEventListener('click', () => setLanguageMenuOpen(languageFilter.getAttribute('aria-expanded') !== 'true'));
      languageFilter?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          setLanguageMenuOpen(true, true);
        } else if (event.key === 'Escape') {
          setLanguageMenuOpen(false);
        }
      });
      languageOptions.forEach((option, index) => {
        option.addEventListener('click', () => selectLanguage(option));
        option.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            const offset = event.key === 'ArrowDown' ? 1 : -1;
            languageOptions[(index + offset + languageOptions.length) % languageOptions.length]?.focus();
          } else if (event.key === 'Home' || event.key === 'End') {
            event.preventDefault();
            languageOptions[event.key === 'Home' ? 0 : languageOptions.length - 1]?.focus();
          } else if (event.key === 'Escape') {
            event.preventDefault();
            setLanguageMenuOpen(false);
            languageFilter?.focus();
          }
        });
      });
      localeTrigger?.addEventListener('click', () => setLocaleMenuOpen(localeTrigger.getAttribute('aria-expanded') !== 'true'));
      localeTrigger?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          setLocaleMenuOpen(true, true);
        } else if (event.key === 'Escape') {
          setLocaleMenuOpen(false);
        }
      });
      localeOptions.forEach((option, index) => option.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const offset = event.key === 'ArrowDown' ? 1 : -1;
          localeOptions[(index + offset + localeOptions.length) % localeOptions.length]?.focus();
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          localeOptions[event.key === 'Home' ? 0 : localeOptions.length - 1]?.focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          setLocaleMenuOpen(false);
          localeTrigger?.focus();
        }
      }));
      document.addEventListener('pointerdown', (event) => {
        if (languagePicker && !languagePicker.contains(event.target as Node)) setLanguageMenuOpen(false);
        if (localePicker && !localePicker.contains(event.target as Node)) setLocaleMenuOpen(false);
      });
      languagePicker?.addEventListener('focusout', () => requestAnimationFrame(() => {
        if (languagePicker && !languagePicker.contains(document.activeElement)) setLanguageMenuOpen(false);
      }));
      localePicker?.addEventListener('focusout', () => requestAnimationFrame(() => {
        if (localePicker && !localePicker.contains(document.activeElement)) setLocaleMenuOpen(false);
      }));
      loadMore?.addEventListener('click', () => { visibleLimit += getPageSize(); render(); });
      const syncSidebarAccess = () => {
        const hidden = compactLayout.matches && !document.body.classList.contains('menu-open');
        if (sidebar instanceof HTMLElement) {
          sidebar.toggleAttribute('inert', hidden);
          if (hidden) sidebar.setAttribute('aria-hidden', 'true');
          else sidebar.removeAttribute('aria-hidden');
        }
      };
      const setMenuOpen = (open: boolean, restoreFocus = false) => {
        const shouldOpen = compactLayout.matches && open;
        if (shouldOpen && sidebar instanceof HTMLElement) {
          sidebar.removeAttribute('inert');
          sidebar.removeAttribute('aria-hidden');
        }
        document.body.classList.toggle('menu-open', shouldOpen);
        if (!shouldOpen) setLocaleMenuOpen(false);
        menuButton?.setAttribute('aria-expanded', String(shouldOpen));
        syncSidebarAccess();
        if (shouldOpen && sidebarClose instanceof HTMLButtonElement) requestAnimationFrame(() => sidebarClose.focus());
        if (!shouldOpen && restoreFocus && menuButton instanceof HTMLButtonElement) menuButton.focus();
      };
      menuButton?.addEventListener('click', () => setMenuOpen(!document.body.classList.contains('menu-open')));
      sidebarClose?.addEventListener('click', () => setMenuOpen(false, true));
      navScrim?.addEventListener('click', () => setMenuOpen(false, true));
      const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('.primary-nav a[href^="#"]:not([data-category-nav])')];
      sectionLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false, true);
      });
      compactLayout.addEventListener('change', () => setMenuOpen(false));
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        sectionLinks.forEach((link) => {
          const active = link.hash === `#${visible.target.id}`;
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-18% 0px -70% 0px', threshold: [0, .15, .5] });
      document.querySelectorAll<HTMLElement>('#overview, #projects, #about').forEach((section) => sectionObserver.observe(section));
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== search) {
          event.preventDefault();
          if (search instanceof HTMLInputElement) search.focus();
        }
      });

      syncSidebarAccess();
      updateSortState();
      render();
    </script>
  </body>
</html>

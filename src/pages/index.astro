---
import '../styles/global.css';
import { catalogStats, categories, projects } from '../lib/catalog';
import {
  AppWindow,
  ArrowDown,
  AtSign,
  BadgeCheck,
  Blocks,
  Bot,
  ChartNoAxesCombined,
  Check,
  ChevronDown,
  CirclePlus,
  FlaskConical,
  Gamepad2,
  House,
  Info,
  Languages,
  LayoutGrid,
  ListTree,
  Mail,
  Menu,
  MonitorSmartphone,
  Search,
  Star,
  Workflow,
  X,
} from '@lucide/astro';

const base = import.meta.env.BASE_URL;
const locale = Astro.props.locale === 'zh' ? 'zh' : 'en';
const isZh = locale === 'zh';
const t = (english: string, chinese: string) => isZh ? chinese : english;
const repositoryUrl = process.env.GITHUB_REPOSITORY
  ? `https://github.com/${process.env.GITHUB_REPOSITORY}`
  : 'https://github.com/heyjunpenn/awesome-jev';
const submissionUrl = `${repositoryUrl}/issues/new?title=${encodeURIComponent('[Submission] ')}`;
const languages = [...new Set(projects.map((project) => project.language).filter((language) => language !== '—'))]
  .sort((a, b) => a.localeCompare(b));
const categoryIcons = [BadgeCheck, Blocks, Workflow, Bot, MonitorSmartphone, AppWindow, Gamepad2, FlaskConical, ChartNoAxesCombined, ListTree];
const navigationCategories = categories.map((category, index) => ({ ...category, Icon: categoryIcons[index] ?? LayoutGrid }));
const repositorySlug = (url: string) => {
  try {
    const [owner, repository] = new URL(url).pathname.split('/').filter(Boolean);
    return owner && repository ? `${owner}/${repository.replace(/\.git$/, '')}` : url;
  } catch {
    return url;
  }
};
const siteUrl = 'https://jevbest.com/';
const pageUrl = isZh ? `${siteUrl}zh/` : siteUrl;
const socialImageUrl = `${siteUrl}readme/awesome-jev-hero.png`;
const authorId = `${siteUrl}#author`;
const publisherId = `${siteUrl}#organization`;
const pageTitle = t(
  `${catalogStats.projects} Jev AI Projects, SDKs & Tools | Awesome Jev`,
  `${catalogStats.projects} 个 Jev AI 开源项目、SDK 与工具 | Awesome Jev`,
);
const pageDescription = t(
  `Search ${catalogStats.projects} open-source projects, SDKs, agents, integrations, benchmarks, and tools built around Jev, TypeSafe AI's System One model.`,
  `收录 ${catalogStats.projects} 个使用 TypeSafe AI System One 模型 Jev 的开源项目，包括 SDK、Agent、集成工具和基准测试。`,
);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': publisherId,
      name: 'Awesome Jev',
      url: siteUrl,
      sameAs: [repositoryUrl, 'https://x.com/heyjunpenn'],
    },
    {
      '@type': 'Person',
      '@id': authorId,
      name: 'heyjunpenn',
      url: 'https://github.com/heyjunpenn',
      sameAs: ['https://github.com/heyjunpenn', 'https://x.com/heyjunpenn'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Awesome Jev',
      description: pageDescription,
      inLanguage: ['en', 'zh-Hans'],
      publisher: { '@id': publisherId },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: t('Awesome Jev Open-Source Project Catalog', 'Awesome Jev 开源项目目录'),
      alternateName: 'Awesome Jev 开源项目目录',
      description: pageDescription,
      isAccessibleForFree: true,
      inLanguage: isZh ? 'zh-Hans' : 'en',
      dateModified: '2026-09-20',
      datePublished: '2026-09-19',
      author: { '@id': authorId },
      publisher: { '@id': publisherId },
      isPartOf: { '@id': `${siteUrl}#website` },
      keywords: ['Jev', 'TypeSafe AI', 'System One model', 'Jev SDK', 'Jev tools', 'Jev agents', 'open-source AI'],
      about: {
        '@type': 'SoftwareApplication',
        name: 'Jev',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Cloud API',
        url: 'https://typesafe.ai/',
      },
      mainEntity: { '@id': `${siteUrl}#projects` },
    },
    {
      '@type': 'Dataset',
      '@id': `${siteUrl}#projects`,
      name: 'Awesome Jev Project Dataset',
      description: `Machine-readable metadata for ${catalogStats.projects} public repositories built around Jev.`,
      url: `${siteUrl}catalog.json`,
      isAccessibleForFree: true,
      inLanguage: ['en', 'zh-Hans'],
      dateModified: '2026-09-20',
      datePublished: '2026-09-19',
      creator: { '@id': authorId },
      publisher: { '@id': publisherId },
      version: '2026-09-20',
      includedInDataCatalog: { '@id': `${siteUrl}#website` },
      distribution: {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: `${siteUrl}catalog.json`,
      },
      hasPart: {
        '@type': 'ItemList',
        numberOfItems: catalogStats.projects,
        itemListElement: projects.slice(0, 20).map((project, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: project.name,
          url: project.url,
        })),
      },
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={isZh ? 'zh-Hans' : 'en'} data-language={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="heyjunpenn" />
    <link rel="canonical" href={pageUrl} />
    <link rel="alternate" hreflang="en" href={siteUrl} />
    <link rel="alternate" hreflang="zh-Hans" href={`${siteUrl}zh/`} />
    <link rel="alternate" hreflang="x-default" href={siteUrl} />
    <link rel="alternate" type="application/json" title="Awesome Jev project catalog" href={`${siteUrl}catalog.json`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Awesome Jev" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={isZh ? 'zh_CN' : 'en_US'} />
    <meta property="og:locale:alternate" content={isZh ? 'en_US' : 'zh_CN'} />
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1983" />
    <meta property="og:image:height" content="793" />
    <meta property="og:image:alt" content={`${catalogStats.projects} verified open-source Jev projects across ${catalogStats.categories} categories`} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heyjunpenn" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={`${catalogStats.projects} verified open-source Jev projects across ${catalogStats.categories} categories`} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HV69G90WGD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HV69G90WGD');
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-head">
          <a class="brand" href="#overview" aria-label="Awesome Jev home">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>AWESOME JEV</span>
          </a>
          <button class="sidebar-close" type="button" aria-label={t('Close navigation', '关闭导航')}><X size={18} stroke-width={1.8} /></button>
        </div>

        <div class="sidebar-scroll">
          <nav class="side-nav primary-nav" aria-label={t('Primary navigation', '主导航')}>
            <a class="active" href="#overview"><House class="nav-icon" size={17} stroke-width={1.8} /><span>{t('Overview', '概览')}</span></a>
            <a href="#projects" data-category-nav="all"><LayoutGrid class="nav-icon" size={17} stroke-width={1.8} /><span>{t('All projects', '全部项目')}</span><small>{catalogStats.projects}</small></a>
            <a href="#about"><Info class="nav-icon" size={17} stroke-width={1.8} /><span>{t('About Jev', '关于 Jev')}</span></a>
            <a href={repositoryUrl} target="_blank" rel="noreferrer">
              <svg class="nav-icon github-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
              </svg>
              <span>GitHub</span>
            </a>
          </nav>

          <div class="sidebar-ad">
            <span class="ad-badge">AD</span>
            <strong>Claim this placement</strong>
            <p>{t('Promote your project', '推广你的项目')}</p>
            <a href="mailto:someuxyz@gmail.com?subject=Awesome%20Jev%20placement">someuxyz@gmail.com</a>
          </div>

          <div class="category-nav-head">
            <span>{t('Categories', '项目分类')}</span>
          </div>
          <nav class="category-nav" aria-label={t('Project categories', '项目分类')}>
            {navigationCategories.map(({ Icon, ...category }) => (
              <a href="#projects" data-category-nav={category.id}>
                <Icon class="nav-icon" size={16} stroke-width={1.75} />
                <span class="localized en-copy">{category.nameEn}</span>
                <span class="localized zh-copy">{category.nameZh}</span>
                <small>{category.count}</small>
              </a>
            ))}
          </nav>

          <div class="collaboration-nav-head">
            <span>{t('Submit & collaborate', '提交与合作')}</span>
          </div>
          <nav class="collaboration-nav" aria-label={t('Submit and collaborate', '提交与合作')}>
            <a href={submissionUrl} target="_blank" rel="noreferrer">
              <CirclePlus class="nav-icon" size={16} stroke-width={1.75} />
              <span>{t('Submit', '提交')}</span>
              <small>GitHub issue</small>
            </a>
            <a href="https://x.com/heyjunpenn" target="_blank" rel="noreferrer">
              <AtSign class="nav-icon" size={16} stroke-width={1.75} />
              <span>X</span>
              <small>@heyjunpenn</small>
            </a>
            <a href="mailto:someuxyz@gmail.com">
              <Mail class="nav-icon" size={16} stroke-width={1.75} />
              <span>{t('Email', '邮件')}</span>
              <small>someuxyz@gmail.com</small>
            </a>
          </nav>

        </div>

        <div class="sidebar-foot">
          <nav class="language-switch" aria-label="Language">
            <span aria-hidden="true"><Languages size={15} stroke-width={1.8} /></span>
            <a class:list={[!isZh && 'selected']} href={base} lang="en" hreflang="en" aria-current={!isZh ? 'page' : undefined}>EN</a>
            <a class:list={[isZh && 'selected']} href={`${base}zh/`} lang="zh-Hans" hreflang="zh-Hans" aria-current={isZh ? 'page' : undefined}>中文</a>
          </nav>
        </div>
      </aside>

      <main>
        <header class="mobile-header">
          <a class="brand" href="#overview"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>AWESOME JEV</span></a>
          <button class="menu-button" type="button" aria-label={t('Open navigation', '打开导航')} aria-controls="sidebar" aria-expanded="false"><Menu size={19} stroke-width={1.8} /></button>
        </header>
        <button class="nav-scrim" type="button" aria-label={t('Close navigation', '关闭导航')} tabindex="-1"></button>

        <section class="hero" id="overview">
          <div class="hero-shell">
            <div class="hero-copy">
              <h1>Best Jav Projects</h1>
              <p>{t(`Search ${catalogStats.projects} verified repositories across ${catalogStats.categories} categories and ${catalogStats.languages} languages.`, `从 ${catalogStats.projects} 个已核验仓库中搜索，也可以按 ${catalogStats.categories} 个分类和 ${catalogStats.languages} 种语言筛选。`)}</p>
              <div class="hero-updated"><span>{t('Last updated', '最近更新')}</span><time datetime="2026-09-20">{t('September 20, 2026', '2026 年 9 月 20 日')}</time></div>
              <div class="filter-panel filter-dock">
                <div class="language-picker" data-language-picker>
                  <button class="language-trigger" id="language-filter" type="button" aria-label={t('Filter by language', '按语言筛选')} aria-haspopup="listbox" aria-expanded="false" aria-controls="language-options">
                    <span data-language-label>{t('All languages', '全部语言')}</span>
                    <ChevronDown class="language-chevron" size={15} stroke-width={1.8} aria-hidden="true" />
                  </button>
                  <div class="language-menu" id="language-options" role="listbox" aria-label={t('Languages', '语言')} hidden>
                    <button class="language-option" type="button" role="option" data-language-value="all" aria-selected="true">
                      <span>{t('All languages', '全部语言')}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                    </button>
                    {languages.map((language) => (
                      <button class="language-option" type="button" role="option" data-language-value={language} aria-selected="false">
                        <span>{language}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                      </button>
                    ))}
                  </div>
                </div>
                <label class="search-box">
                  <span aria-hidden="true"><Search size={18} stroke-width={1.8} /></span>
                  <input id="project-search" type="search" placeholder={t('Search projects, languages, or decisions', '搜索项目、语言或决策')} autocomplete="off" />
                  <kbd>/</kbd>
                </label>
              </div>
            </div>

            <figure class="hero-illustration">
              <img src={`${base}jev-decision-flow.svg`} width="760" height="500" alt={t('Structured inputs flow through Jev into probabilistic decisions', '结构化输入经过 Jev，转化为概率决策')} />
            </figure>
          </div>
        </section>

        <div class="catalog-region">
          <section class="catalog" id="projects">
            <div class="category-strip" role="group" aria-label={t('Project categories', '项目分类')}>
              <button class="category-button selected" type="button" data-category="all"><span>{t('All', '全部')}</span><b>{projects.length}</b></button>
              {categories.map((category) => (
                <button class="category-button" type="button" data-category={category.id}>
                  <span class="localized en-copy">{category.nameEn}</span>
                  <span class="localized zh-copy">{category.nameZh}</span>
                  <b>{category.count}</b>
                </button>
              ))}
            </div>

            <div class="table-heading" role="row">
              <span role="columnheader">{t('Project', '项目')}</span>
              <span class="star-heading" role="columnheader" aria-sort="descending">
                <button
                  class="sort-button"
                  id="star-sort"
                  type="button"
                  data-direction="desc"
                  data-label-ascending={t('Sort by stars ascending', '按 Star 升序排列')}
                  data-label-descending={t('Sort by stars descending', '按 Star 降序排列')}
                  aria-label={t('Sort by stars ascending', '按 Star 升序排列')}
                >{t('Stars', 'Star')}<ArrowDown size={13} stroke-width={1.9} aria-hidden="true" /></button>
              </span>
              <span role="columnheader">{t('Language', '语言')}</span>
              <span role="columnheader">{t('Description', '简介')}</span>
            </div>
            <ol class="project-table" id="project-table" aria-label={t('Jev projects', 'Jev 项目')}>
              {projects.map((project) => (
                <li class="project-row" data-project data-stars={project.stars} data-category={project.categoryId} data-language={project.language} data-search={`${project.name} ${repositorySlug(project.url)} ${project.language} ${project.descriptionEn} ${project.descriptionZh}`.toLowerCase()}>
                  <a class="project-name" href={project.url} target="_blank" rel="noreferrer"><h3>{repositorySlug(project.url)}</h3><small class="localized en-copy">{project.categoryEn}</small><small class="localized zh-copy">{project.categoryZh}</small></a>
                  <span class="stars"><Star class="star-icon" size={13} stroke-width={1.8} aria-hidden="true" />{project.starsLabel}</span>
                  <span class="project-language">{project.language}</span>
                  <p class="localized en-copy">{project.descriptionEn}</p>
                  <p class="localized zh-copy">{project.descriptionZh}</p>
                </li>
              ))}
            </ol>

            <div class="empty-state" id="empty-state" hidden><strong>{t('No matching projects', '没有符合条件的项目')}</strong><span>{t('Try another keyword or category.', '换个关键词或分类试试。')}</span></div>
            <button class="load-more" id="load-more" type="button"><span>{t('Show more projects', '查看更多')}</span><b>↓</b></button>
          </section>
        </div>

        <section class="about" id="about">
          <div class="about-intro">
            <h2>{t('What is Jev?', 'Jev 是什么？')}</h2>
            <div class="about-copy">
              <p class="localized en-copy">Jev is TypeSafe AI's System One model for decisions that software needs to consume. Instead of generating free-form prose, it accepts a state and one or more typed questions, then returns structured answers with calibrated probabilities.</p>
              <p class="localized zh-copy">Jev 是 TypeSafe AI 推出的 System One 模型，供软件直接调用来做判断。它接收状态信息和一个或多个类型化问题，不生成自由文本，直接返回结构化答案和校准后的概率。</p>
              <p class="localized en-copy">It fits workflows where the option space or scoring rubric is known in advance: routing an agent, validating a tool call, ranking candidates, checking a policy, or deciding whether an action should proceed.</p>
              <p class="localized zh-copy">当选项范围或评分规则已经明确，Jev 可以给 Agent 分流、校验工具调用、排列候选项、检查策略，也可以判断一次操作是否该继续。</p>
            </div>
            <div class="about-note">
              <span>{t('Operational advantage', '工程优势')}</span>
              <p class="localized en-copy">Applications can set deterministic thresholds, inspect uncertainty, and route low-confidence cases to a person or a larger model.</p>
              <p class="localized zh-copy">开发者可以在代码里设定阈值，直接查看结果有多大把握。置信度不足时，再交给人工或更大的模型处理。</p>
            </div>
          </div>
          <div class="primitive-grid">
            <article><span>CHOICE</span><h3>{t('Pick one option', '做单项选择')}</h3><p>{t('Select from a known set and return probabilities with confidence.', '从给定选项中选出一个，并给出每个选项的概率。')}</p></article>
            <article><span>SCORE</span><h3>{t('Rate on a rubric', '按量表打分')}</h3><p>{t('Place an input on an ordered scale with a full distribution.', '把输入放到有序量表上，并返回各档位的概率。')}</p></article>
            <article><span>NOUL</span><h3>{t('Estimate truth', '判断真假')}</h3><p>{t('Return the probability that a statement is true, from zero to one.', '判断一段陈述为真的可能性，返回 0 到 1 的概率。')}</p></article>
          </div>
        </section>

        <section class="methodology" id="methodology">
          <div>
            <h2>{t('How is this catalog verified?', '这份目录如何核验？')}</h2>
          </div>
          <div class="methodology-copy">
            <p class="localized en-copy">Each entry is checked against public evidence: the upstream repository, project-authored documentation, and visible Jev usage. Stars are a dated discovery snapshot, not a quality ranking.</p>
            <p class="localized zh-copy">我们会检查每个条目的公开依据，包括上游仓库、项目文档以及可以确认的 Jev 用法。Star 数记录的是核验当天的快照，只供参考，不代表项目质量。</p>
            <p class="catalog-byline"><span>{t('Curated by', '整理：')}</span> <a href="https://github.com/heyjunpenn" rel="author">heyjunpenn</a></p>
            <blockquote cite="https://typesafe.ai/blog/introducing-system-one-models-and-jev">
              <span class="localized en-copy">“Think of Jev as a frontier-intelligence function call: unstructured state in, typed probabilistic decisions out.”</span>
              <span class="localized zh-copy">“可以把 Jev 看成一次前沿智能函数调用：输入非结构化状态，输出带类型的概率决策。”</span>
              <cite>— <a href="https://typesafe.ai/blog/introducing-system-one-models-and-jev" target="_blank" rel="noreferrer"><span class="localized en-copy">TypeSafe AI, introducing Jev</span><span class="localized zh-copy">TypeSafe AI，《Introducing System One Models and Jev》</span></a></cite>
            </blockquote>
            <h3>{t('Which sources does Awesome Jev use?', '核验时看哪些资料？')}</h3>
            <ul>
              <li class="localized en-copy"><a href="https://docs.typesafe.ai/" target="_blank" rel="noreferrer">Official Jev documentation</a> for product concepts and primitives.</li>
              <li class="localized zh-copy"><a href="https://docs.typesafe.ai/" target="_blank" rel="noreferrer">Jev 官方文档</a>，用于核对产品概念和基础能力。</li>
              <li class="localized en-copy"><a href={repositoryUrl} target="_blank" rel="noreferrer">Public GitHub repositories</a> for implementation evidence and metadata.</li>
              <li class="localized zh-copy"><a href={repositoryUrl} target="_blank" rel="noreferrer">公开 GitHub 仓库</a>，用于确认实现方式和项目数据。</li>
              <li class="localized en-copy"><a href={`${siteUrl}catalog.json`}>Machine-readable catalog data</a> for reproducible project records.</li>
              <li class="localized zh-copy"><a href={`${siteUrl}catalog.json`}>可机读目录数据</a>，用于复核每条项目记录。</li>
            </ul>
          </div>
        </section>

        <footer>
          <span>AWESOME JEV / 2026</span>
          <nav aria-label={t('Site information', '网站信息')}>
            <a href="#about">{t('About', '关于')}</a>
            <a href="mailto:someuxyz@gmail.com">{t('Contact', '联系')}</a>
            <a href={`${base}privacy/`}>{t('Privacy', '隐私')}</a>
            <a href={`${base}terms/`}>{t('Terms', '条款')}</a>
            <a href="https://docs.typesafe.ai/" target="_blank" rel="noreferrer"><span>{t('Jev docs', 'Jev 文档')}</span> ↗</a>
          </nav>
        </footer>
      </main>
    </div>

    <script>
      const rows = [...document.querySelectorAll<HTMLElement>('[data-project]')];
      const search = document.querySelector<HTMLInputElement>('#project-search');
      const languagePicker = document.querySelector<HTMLElement>('[data-language-picker]');
      const languageFilter = document.querySelector<HTMLButtonElement>('#language-filter');
      const languageMenu = document.querySelector<HTMLElement>('#language-options');
      const languageLabel = document.querySelector<HTMLElement>('[data-language-label]');
      const languageOptions = [...document.querySelectorAll<HTMLButtonElement>('[data-language-value]')];
      const projectTable = document.querySelector<HTMLOListElement>('#project-table');
      const starSort = document.querySelector<HTMLButtonElement>('#star-sort');
      const starHeading = document.querySelector<HTMLElement>('.star-heading');
      const loadMore = document.querySelector('#load-more');
      const emptyState = document.querySelector('#empty-state');
      const menuButton = document.querySelector('.menu-button');
      const sidebarClose = document.querySelector('.sidebar-close');
      const navScrim = document.querySelector('.nav-scrim');
      const sidebar = document.querySelector('#sidebar');
      const compactLayout = window.matchMedia('(max-width: 1080px)');
      const getPageSize = () => compactLayout.matches ? 16 : 36;
      let activeCategory = 'all';
      let selectedLanguage = 'all';
      let starSortDirection: 'asc' | 'desc' = 'desc';
      let visibleLimit = getPageSize();

      const sortRowsByStars = () => {
        rows.sort((a, b) => {
          const difference = Number(a.dataset.stars ?? 0) - Number(b.dataset.stars ?? 0);
          if (difference !== 0) return starSortDirection === 'desc' ? -difference : difference;
          const aName = a.querySelector('h3')?.textContent ?? '';
          const bName = b.querySelector('h3')?.textContent ?? '';
          return aName.localeCompare(bName);
        });
        rows.forEach((row) => projectTable?.append(row));
        starSort?.setAttribute('data-direction', starSortDirection);
        starHeading?.setAttribute('aria-sort', starSortDirection === 'desc' ? 'descending' : 'ascending');
        if (starSort) {
          starSort.setAttribute('aria-label', starSortDirection === 'desc'
            ? starSort.dataset.labelAscending ?? ''
            : starSort.dataset.labelDescending ?? '');
        }
      };

      const render = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const matches = rows.filter((row) => {
          const categoryMatch = activeCategory === 'all' || row.dataset.category === activeCategory;
          const languageMatch = selectedLanguage === 'all' || row.dataset.language === selectedLanguage;
          const searchMatch = !query || (row.dataset.search ?? '').includes(query);
          return categoryMatch && languageMatch && searchMatch;
        });

        rows.forEach((row) => row.setAttribute('hidden', ''));
        matches.slice(0, visibleLimit).forEach((row) => row.removeAttribute('hidden'));
        if (loadMore instanceof HTMLButtonElement) loadMore.hidden = matches.length <= visibleLimit;
        if (emptyState instanceof HTMLElement) emptyState.hidden = matches.length !== 0;
      };

      const setLanguageMenuOpen = (open: boolean, focusOption = false) => {
        if (!(languageFilter instanceof HTMLButtonElement) || !(languageMenu instanceof HTMLElement)) return;
        languageFilter.setAttribute('aria-expanded', String(open));
        languageMenu.hidden = !open;
        if (open && focusOption) {
          (languageOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? languageOptions[0])?.focus();
        }
      };

      const selectLanguage = (option: HTMLButtonElement) => {
        selectedLanguage = option.dataset.languageValue ?? 'all';
        if (languageLabel) languageLabel.textContent = option.querySelector('span')?.textContent ?? option.textContent?.trim() ?? '';
        languageOptions.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
        visibleLimit = getPageSize();
        setLanguageMenuOpen(false);
        render();
        languageFilter?.focus();
      };

      document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]').forEach((button) => button.addEventListener('click', () => {
        activeCategory = button.dataset.category ?? 'all';
        visibleLimit = getPageSize();
        document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]').forEach((item) => item.classList.toggle('selected', item === button));
        document.querySelectorAll<HTMLAnchorElement>('.category-nav [data-category-nav]').forEach((item) => {
          const selected = item.dataset.categoryNav === activeCategory;
          item.classList.toggle('selected', selected);
          if (selected) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        });
        render();
      }));
      search?.addEventListener('input', () => { visibleLimit = getPageSize(); render(); });
      starSort?.addEventListener('click', () => {
        starSortDirection = starSortDirection === 'desc' ? 'asc' : 'desc';
        visibleLimit = getPageSize();
        sortRowsByStars();
        render();
      });
      languageFilter?.addEventListener('click', () => setLanguageMenuOpen(languageFilter.getAttribute('aria-expanded') !== 'true'));
      languageFilter?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          setLanguageMenuOpen(true, true);
        } else if (event.key === 'Escape') {
          setLanguageMenuOpen(false);
        }
      });
      languageOptions.forEach((option, index) => {
        option.addEventListener('click', () => selectLanguage(option));
        option.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            const offset = event.key === 'ArrowDown' ? 1 : -1;
            languageOptions[(index + offset + languageOptions.length) % languageOptions.length]?.focus();
          } else if (event.key === 'Home' || event.key === 'End') {
            event.preventDefault();
            languageOptions[event.key === 'Home' ? 0 : languageOptions.length - 1]?.focus();
          } else if (event.key === 'Escape') {
            event.preventDefault();
            setLanguageMenuOpen(false);
            languageFilter?.focus();
          }
        });
      });
      document.addEventListener('pointerdown', (event) => {
        if (languagePicker && !languagePicker.contains(event.target as Node)) setLanguageMenuOpen(false);
      });
      languagePicker?.addEventListener('focusout', () => requestAnimationFrame(() => {
        if (languagePicker && !languagePicker.contains(document.activeElement)) setLanguageMenuOpen(false);
      }));
      loadMore?.addEventListener('click', () => { visibleLimit += getPageSize(); render(); });
      const syncSidebarAccess = () => {
        const hidden = compactLayout.matches && !document.body.classList.contains('menu-open');
        if (sidebar instanceof HTMLElement) {
          sidebar.toggleAttribute('inert', hidden);
          if (hidden) sidebar.setAttribute('aria-hidden', 'true');
          else sidebar.removeAttribute('aria-hidden');
        }
      };
      const setMenuOpen = (open: boolean, restoreFocus = false) => {
        const shouldOpen = compactLayout.matches && open;
        if (shouldOpen && sidebar instanceof HTMLElement) {
          sidebar.removeAttribute('inert');
          sidebar.removeAttribute('aria-hidden');
        }
        document.body.classList.toggle('menu-open', shouldOpen);
        menuButton?.setAttribute('aria-expanded', String(shouldOpen));
        syncSidebarAccess();
        if (shouldOpen && sidebarClose instanceof HTMLButtonElement) requestAnimationFrame(() => sidebarClose.focus());
        if (!shouldOpen && restoreFocus && menuButton instanceof HTMLButtonElement) menuButton.focus();
      };
      menuButton?.addEventListener('click', () => setMenuOpen(!document.body.classList.contains('menu-open')));
      sidebarClose?.addEventListener('click', () => setMenuOpen(false, true));
      navScrim?.addEventListener('click', () => setMenuOpen(false, true));
      const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('.primary-nav a[href^="#"]')];
      sectionLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.querySelectorAll<HTMLAnchorElement>('[data-category-nav]').forEach((link) => link.addEventListener('click', () => {
        const category = link.dataset.categoryNav ?? 'all';
        const target = [...document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]')]
          .find((item) => item.dataset.category === category);
        target?.click();
        setMenuOpen(false);
      }));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false, true);
      });
      compactLayout.addEventListener('change', () => setMenuOpen(false));
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        sectionLinks.forEach((link) => {
          const active = link.hash === `#${visible.target.id}`;
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-18% 0px -70% 0px', threshold: [0, .15, .5] });
      document.querySelectorAll<HTMLElement>('#overview, #projects, #about').forEach((section) => sectionObserver.observe(section));
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== search) {
          event.preventDefault();
          if (search instanceof HTMLInputElement) search.focus();
        }
      });

      syncSidebarAccess();
      sortRowsByStars();
      render();
    </script>
  </body>
</html>

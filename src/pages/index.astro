---
import '../styles/global.css';
import { catalogStats, categories, projects } from '../lib/catalog';
import {
  AppWindow,
  AtSign,
  BadgeCheck,
  Blocks,
  Bot,
  ChartNoAxesCombined,
  CirclePlus,
  FlaskConical,
  Gamepad2,
  House,
  Info,
  Languages,
  LayoutGrid,
  ListTree,
  Mail,
  Menu,
  MonitorSmartphone,
  Sparkles,
  Workflow,
  X,
} from '@lucide/astro';

const base = import.meta.env.BASE_URL;
const repositoryUrl = process.env.GITHUB_REPOSITORY
  ? `https://github.com/${process.env.GITHUB_REPOSITORY}`
  : 'https://github.com/heyjunpenn/awesome-jev';
const submissionUrl = `${repositoryUrl}/issues/new?title=${encodeURIComponent('[Submission] ')}`;
const featured = projects.find((project) => project.url === 'https://github.com/browser-use/jev-ultrafast') ?? projects[0];
const languages = [...new Set(projects.map((project) => project.language).filter((language) => language !== '—'))]
  .sort((a, b) => a.localeCompare(b));
const categoryIcons = [BadgeCheck, Blocks, Workflow, Bot, MonitorSmartphone, AppWindow, Gamepad2, FlaskConical, ChartNoAxesCombined, ListTree];
const navigationCategories = categories.map((category, index) => ({ ...category, Icon: categoryIcons[index] ?? LayoutGrid }));
const siteUrl = 'https://jevbest.com/';
const pageTitle = `${catalogStats.projects} Jev AI Projects, SDKs & Tools | Awesome Jev`;
const pageDescription = `Explore ${catalogStats.projects} open-source projects, SDKs, agents, integrations, benchmarks, and tools built around Jev, TypeSafe AI's System One model.`;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'Awesome Jev',
      description: pageDescription,
      inLanguage: ['en', 'zh-Hans'],
    },
    {
      '@type': 'CollectionPage',
      '@id': `${siteUrl}#webpage`,
      url: siteUrl,
      name: 'Awesome Jev Open-Source Project Catalog',
      alternateName: 'Awesome Jev 开源项目目录',
      description: pageDescription,
      isAccessibleForFree: true,
      inLanguage: ['en', 'zh-Hans'],
      dateModified: '2026-09-19',
      isPartOf: { '@id': `${siteUrl}#website` },
      keywords: ['Jev', 'TypeSafe AI', 'System One model', 'Jev SDK', 'Jev tools', 'Jev agents', 'open-source AI'],
      about: {
        '@type': 'SoftwareApplication',
        name: 'Jev',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Cloud API',
        url: 'https://typesafe.ai/',
      },
      mainEntity: { '@id': `${siteUrl}#projects` },
    },
    {
      '@type': 'Dataset',
      '@id': `${siteUrl}#projects`,
      name: 'Awesome Jev Project Dataset',
      description: `Machine-readable metadata for ${catalogStats.projects} public repositories built around Jev.`,
      url: `${siteUrl}catalog.json`,
      isAccessibleForFree: true,
      inLanguage: ['en', 'zh-Hans'],
      dateModified: '2026-09-19',
      version: '2026-09-19',
      includedInDataCatalog: { '@id': `${siteUrl}#website` },
      distribution: {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: `${siteUrl}catalog.json`,
      },
      hasPart: {
        '@type': 'ItemList',
        numberOfItems: catalogStats.projects,
        itemListElement: projects.slice(0, 20).map((project, index) => ({
          '@type': 'ListItem',
          position: index + 1,
          name: project.name,
          url: project.url,
        })),
      },
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="Awesome Jev community" />
    <link rel="canonical" href={siteUrl} />
    <link rel="alternate" type="application/json" title="Awesome Jev project catalog" href={`${siteUrl}catalog.json`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Awesome Jev" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:locale:alternate" content="zh_CN" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
    <!-- Google tag (gtag.js) -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HV69G90WGD"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HV69G90WGD');
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-head">
          <a class="brand" href="#overview" aria-label="Awesome Jev home">
            <span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span>
            <span>AWESOME JEV</span>
          </a>
          <button class="sidebar-close" type="button" aria-label="Close navigation"><X size={18} stroke-width={1.8} /></button>
        </div>

        <div class="sidebar-scroll">
          <nav class="side-nav primary-nav" aria-label="Primary navigation">
            <a class="active" href="#overview"><House class="nav-icon" size={17} stroke-width={1.8} /><span data-en="Overview" data-zh="概览">Overview</span></a>
            <a href="#featured"><Sparkles class="nav-icon" size={17} stroke-width={1.8} /><span data-en="Featured" data-zh="精选项目">Featured</span></a>
            <a href="#projects" data-category-nav="all"><LayoutGrid class="nav-icon" size={17} stroke-width={1.8} /><span data-en="All projects" data-zh="全部项目">All projects</span><small>{catalogStats.projects}</small></a>
            <a href="#about"><Info class="nav-icon" size={17} stroke-width={1.8} /><span data-en="About Jev" data-zh="关于 Jev">About Jev</span></a>
            <a href={repositoryUrl} target="_blank" rel="noreferrer">
              <svg class="nav-icon github-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
              </svg>
              <span>GitHub</span>
            </a>
          </nav>

          <div class="category-nav-head">
            <span data-en="Categories" data-zh="项目分类">Categories</span>
            <span>{catalogStats.categories}</span>
          </div>
          <nav class="category-nav" aria-label="Project categories">
            {navigationCategories.map(({ Icon, ...category }) => (
              <a href="#projects" data-category-nav={category.id}>
                <Icon class="nav-icon" size={16} stroke-width={1.75} />
                <span class="localized en-copy">{category.nameEn}</span>
                <span class="localized zh-copy">{category.nameZh}</span>
                <small>{category.count}</small>
              </a>
            ))}
          </nav>

          <div class="collaboration-nav-head">
            <span data-en="Submit & collaborate" data-zh="提交与合作">Submit & collaborate</span>
          </div>
          <nav class="collaboration-nav" aria-label="Submit and collaborate">
            <a href={submissionUrl} target="_blank" rel="noreferrer">
              <CirclePlus class="nav-icon" size={16} stroke-width={1.75} />
              <span data-en="Submit" data-zh="提交">Submit</span>
              <small>GitHub issue</small>
            </a>
            <a href="https://x.com/heyjunpenn" target="_blank" rel="noreferrer">
              <AtSign class="nav-icon" size={16} stroke-width={1.75} />
              <span>X</span>
              <small>@heyjunpenn</small>
            </a>
            <a href="mailto:someuxyz@gmail">
              <Mail class="nav-icon" size={16} stroke-width={1.75} />
              <span data-en="Email" data-zh="邮件">Email</span>
              <small>someuxyz@gmail</small>
            </a>
          </nav>
        </div>

        <div class="sidebar-foot">
          <div class="language-switch" role="group" aria-label="Language">
            <span aria-hidden="true"><Languages size={15} stroke-width={1.8} /></span>
            <button class="selected" type="button" data-lang-button="en">EN</button>
            <button type="button" data-lang-button="zh">中文</button>
          </div>
        </div>
      </aside>

      <main>
        <header class="mobile-header">
          <a class="brand" href="#overview"><span class="brand-mark" aria-hidden="true"><i></i><i></i><i></i></span><span>AWESOME JEV</span></a>
          <button class="menu-button" type="button" aria-label="Open navigation" aria-controls="sidebar" aria-expanded="false"><Menu size={19} stroke-width={1.8} /></button>
        </header>
        <button class="nav-scrim" type="button" aria-label="Close navigation" tabindex="-1"></button>

        <section class="hero" id="overview">
          <div class="hero-copy">
            <div class="eyebrow"><span>OPEN SOURCE CATALOG</span><span>JEV / SYSTEM ONE</span></div>
            <h1 data-en="Explore the Jev ecosystem." data-zh="发现更多 Jev 项目">Explore the Jev ecosystem.</h1>
            <p data-en="Discover public tools, agents, experiments, and research built around typed decisions." data-zh="这里收录了使用 Jev 构建的开源工具、Agent、实验项目和研究成果。">Discover public tools, agents, experiments, and research built around typed decisions.</p>
            <a class="primary-action" href="#projects"><span data-en="Browse 433 projects" data-zh="查看 433 个项目">Browse 433 projects</span><b>→</b></a>
          </div>

          <div class="category-board" aria-label="Browse project categories">
            <div class="category-board-head">
              <div><span>PROJECT INDEX</span><strong data-en="Browse by category" data-zh="按分类查找">Browse by category</strong></div>
              <div class="category-total"><b>{catalogStats.categories}</b><span data-en="categories" data-zh="个分类">categories</span></div>
            </div>
            <div class="hero-category-grid">
              {categories.map((category, index) => (
                <button type="button" data-category-jump={category.id}>
                  <small>{String(index + 1).padStart(2, '0')}</small>
                  <span class="localized en-copy">{category.nameEn}</span>
                  <span class="localized zh-copy">{category.nameZh}</span>
                  <b>{category.count}</b>
                  <i aria-hidden="true">↘</i>
                </button>
              ))}
            </div>
            <div class="category-board-foot"><span>{catalogStats.projects} REPOSITORIES</span><span>{catalogStats.languages} LANGUAGES</span></div>
          </div>
        </section>

        <section class="featured-grid" id="featured">
          <article class="featured-copy">
            <div class="section-label"><span data-en="Featured project" data-zh="精选项目">Featured project</span><span>CALL SITE VERIFIED</span></div>
            <h2>{featured.name}</h2>
            <p class="localized en-copy">{featured.descriptionEn}</p>
            <p class="localized zh-copy">{featured.descriptionZh}</p>
            <div class="project-meta"><span>★ {featured.starsLabel}</span><span>{featured.language}</span><span class="localized en-copy">{featured.categoryEn}</span><span class="localized zh-copy">{featured.categoryZh}</span></div>
            <a class="text-link" href={featured.url} target="_blank" rel="noreferrer"><span data-en="Open repository" data-zh="查看仓库">Open repository</span> ↗</a>
          </article>

          <div class="featured-side">
            <div class="metric-card"><span data-en="Open repositories" data-zh="开源仓库">Open repositories</span><strong>{catalogStats.projects}</strong><small data-en="across ten categories" data-zh="共分 10 类">across ten categories</small></div>
            <div class="metric-card accent"><span data-en="Primary sort" data-zh="默认排序">Primary sort</span><strong>★</strong><small data-en="Stars, high to low" data-zh="按 Star 数从高到低">Stars, high to low</small></div>
          </div>
        </section>

        <section class="catalog" id="projects">
          <div class="catalog-head">
            <div>
              <span class="section-kicker" data-en="Explore the ecosystem" data-zh="Jev 项目目录">Explore the ecosystem</span>
              <h2 data-en="Browse projects" data-zh="查找项目">Browse projects</h2>
            </div>
            <div class="result-count"><strong id="result-count">{projects.length}</strong><span data-en="results" data-zh="个项目">results</span></div>
          </div>

          <div class="filter-panel">
            <label class="search-box">
              <span aria-hidden="true">⌕</span>
              <input id="project-search" type="search" placeholder="Search projects, languages, or decisions" autocomplete="off" />
              <kbd>/</kbd>
            </label>
            <label class="select-wrap">
              <span data-en="Language" data-zh="语言">Language</span>
              <select id="language-filter">
                <option value="all" data-en="All languages" data-zh="全部语言">All languages</option>
                {languages.map((language) => <option value={language}>{language}</option>)}
              </select>
            </label>
          </div>

          <div class="category-strip" role="group" aria-label="Project categories">
            <button class="category-button selected" type="button" data-category="all"><span data-en="All" data-zh="全部">All</span><b>{projects.length}</b></button>
            {categories.map((category) => (
              <button class="category-button" type="button" data-category={category.id}>
                <span class="localized en-copy">{category.nameEn}</span>
                <span class="localized zh-copy">{category.nameZh}</span>
                <b>{category.count}</b>
              </button>
            ))}
          </div>

          <div class="project-table" id="project-table">
            <div class="table-heading"><span data-en="Project" data-zh="项目">Project</span><span data-en="Stars" data-zh="Stars">Stars</span><span data-en="Language" data-zh="语言">Language</span><span data-en="Description" data-zh="描述">Description</span></div>
            {projects.map((project) => (
              <article class="project-row" data-project data-category={project.categoryId} data-language={project.language} data-search={`${project.name} ${project.language} ${project.descriptionEn} ${project.descriptionZh}`.toLowerCase()}>
                <a class="project-name" href={project.url} target="_blank" rel="noreferrer"><span>{project.name}</span><small class="localized en-copy">{project.categoryEn}</small><small class="localized zh-copy">{project.categoryZh}</small></a>
                <span class="stars">★ {project.starsLabel}</span>
                <span class="project-language">{project.language}</span>
                <p class="localized en-copy">{project.descriptionEn}</p>
                <p class="localized zh-copy">{project.descriptionZh}</p>
              </article>
            ))}
          </div>

          <div class="empty-state" id="empty-state" hidden><strong data-en="No matching projects" data-zh="没有找到匹配的项目">No matching projects</strong><span data-en="Try another keyword or category." data-zh="换个关键词或分类试试。">Try another keyword or category.</span></div>
          <button class="load-more" id="load-more" type="button"><span data-en="Show more projects" data-zh="加载更多">Show more projects</span><b>↓</b></button>
        </section>

        <section class="about" id="about">
          <div class="about-intro">
            <span class="section-kicker">TYPE-SAFE DECISIONS</span>
            <h2 data-en="What is Jev?" data-zh="Jev 是什么？">What is Jev?</h2>
            <div class="about-copy">
              <p class="localized en-copy">Jev is TypeSafe AI's System One model for decisions that software needs to consume. Instead of generating free-form prose, it accepts a state and one or more typed questions, then returns structured answers with calibrated probabilities.</p>
              <p class="localized zh-copy">Jev 是 TypeSafe AI 的 System One 模型，专门处理软件中的决策问题。它不会生成自由文本，而是读取当前状态和一个或多个类型化问题，返回结构化答案及经过校准的概率。</p>
              <p class="localized en-copy">It fits workflows where the option space or scoring rubric is known in advance: routing an agent, validating a tool call, ranking candidates, checking a policy, or deciding whether an action should proceed.</p>
              <p class="localized zh-copy">当候选范围或评分标准已经明确时，Jev 很适合用来做 Agent 路由、工具调用校验、候选项排序、策略检查，或判断某项操作是否应该继续。</p>
            </div>
            <div class="about-note">
              <span data-en="Operational advantage" data-zh="工程优势">Operational advantage</span>
              <p class="localized en-copy">Applications can set deterministic thresholds, inspect uncertainty, and route low-confidence cases to a person or a larger model.</p>
              <p class="localized zh-copy">开发者可以自行设定阈值，查看结果的不确定性，再把低置信度的情况交给人工或更大的模型处理。</p>
            </div>
          </div>
          <div class="primitive-grid">
            <article><span>01 / CHOICE</span><h3 data-en="Pick one option" data-zh="从选项中作出选择">Pick one option</h3><p data-en="Select from a known set and return probabilities with confidence." data-zh="从给定选项中选出一个，并返回相应的概率和置信度。">Select from a known set and return probabilities with confidence.</p></article>
            <article><span>02 / SCORE</span><h3 data-en="Rate on a rubric" data-zh="按照量表评分">Rate on a rubric</h3><p data-en="Place an input on an ordered scale with a full distribution." data-zh="按照有序量表为输入评分，并返回完整的概率分布。">Place an input on an ordered scale with a full distribution.</p></article>
            <article><span>03 / NOUL</span><h3 data-en="Estimate truth" data-zh="估算陈述为真的概率">Estimate truth</h3><p data-en="Return the probability that a statement is true, from zero to one." data-zh="估算某个陈述为真的概率，取值为 0 到 1。">Return the probability that a statement is true, from zero to one.</p></article>
          </div>
        </section>

        <footer>
          <span>AWESOME JEV / 2026</span>
          <span data-en="Independent community project" data-zh="独立社区项目">Independent community project</span>
          <a href="https://docs.typesafe.ai/" target="_blank" rel="noreferrer"><span data-en="Official Jev documentation" data-zh="Jev 官方文档">Official Jev documentation</span> ↗</a>
        </footer>
      </main>
    </div>

    <script>
      const root = document.documentElement;
      const rows = [...document.querySelectorAll<HTMLElement>('[data-project]')];
      const search = document.querySelector<HTMLInputElement>('#project-search');
      const languageFilter = document.querySelector<HTMLSelectElement>('#language-filter');
      const resultCount = document.querySelector('#result-count');
      const loadMore = document.querySelector('#load-more');
      const emptyState = document.querySelector('#empty-state');
      const menuButton = document.querySelector('.menu-button');
      const sidebarClose = document.querySelector('.sidebar-close');
      const navScrim = document.querySelector('.nav-scrim');
      let activeCategory = 'all';
      let visibleLimit = 36;

      const applyTranslations = (language: 'en' | 'zh') => {
        root.dataset.language = language;
        root.lang = language === 'zh' ? 'zh-Hans' : 'en';
        document.querySelectorAll('[data-en][data-zh]').forEach((node) => {
          if (node instanceof HTMLElement) node.innerHTML = node.dataset[language] ?? node.innerHTML;
        });
        document.querySelectorAll<HTMLElement>('[data-lang-button]').forEach((button) => button.classList.toggle('selected', button.dataset.langButton === language));
        if (search instanceof HTMLInputElement) search.placeholder = language === 'zh' ? '搜索项目、语言或决策' : 'Search projects, languages, or decisions';
        if (languageFilter instanceof HTMLSelectElement) {
          const allOption = languageFilter.querySelector('option[value="all"]');
          if (allOption instanceof HTMLOptionElement) allOption.textContent = language === 'zh' ? '全部语言' : 'All languages';
        }
        localStorage.setItem('awesome-jev-language', language);
      };

      const render = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const selectedLanguage = languageFilter instanceof HTMLSelectElement ? languageFilter.value : 'all';
        const matches = rows.filter((row) => {
          const categoryMatch = activeCategory === 'all' || row.dataset.category === activeCategory;
          const languageMatch = selectedLanguage === 'all' || row.dataset.language === selectedLanguage;
          const searchMatch = !query || (row.dataset.search ?? '').includes(query);
          return categoryMatch && languageMatch && searchMatch;
        });

        rows.forEach((row) => row.setAttribute('hidden', ''));
        matches.slice(0, visibleLimit).forEach((row) => row.removeAttribute('hidden'));
        if (resultCount) resultCount.textContent = String(matches.length);
        if (loadMore instanceof HTMLButtonElement) loadMore.hidden = matches.length <= visibleLimit;
        if (emptyState instanceof HTMLElement) emptyState.hidden = matches.length !== 0;
      };

      document.querySelectorAll<HTMLElement>('[data-lang-button]').forEach((button) => button.addEventListener('click', () => applyTranslations(button.dataset.langButton === 'zh' ? 'zh' : 'en')));
      document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]').forEach((button) => button.addEventListener('click', () => {
        activeCategory = button.dataset.category ?? 'all';
        visibleLimit = 36;
        document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]').forEach((item) => item.classList.toggle('selected', item === button));
        document.querySelectorAll<HTMLAnchorElement>('.category-nav [data-category-nav]').forEach((item) => {
          const selected = item.dataset.categoryNav === activeCategory;
          item.classList.toggle('selected', selected);
          if (selected) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        });
        render();
      }));
      document.querySelectorAll<HTMLButtonElement>('[data-category-jump]').forEach((button) => button.addEventListener('click', () => {
        const category = button.dataset.categoryJump;
        const target = [...document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]')]
          .find((item) => item.dataset.category === category);
        target?.click();
        document.querySelector('#projects')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }));
      search?.addEventListener('input', () => { visibleLimit = 36; render(); });
      languageFilter?.addEventListener('change', () => { visibleLimit = 36; render(); });
      loadMore?.addEventListener('click', () => { visibleLimit += 36; render(); });
      const setMenuOpen = (open: boolean) => {
        document.body.classList.toggle('menu-open', open);
        menuButton?.setAttribute('aria-expanded', String(open));
      };
      menuButton?.addEventListener('click', () => setMenuOpen(!document.body.classList.contains('menu-open')));
      sidebarClose?.addEventListener('click', () => setMenuOpen(false));
      navScrim?.addEventListener('click', () => setMenuOpen(false));
      const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('.primary-nav a[href^="#"]')];
      sectionLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.querySelectorAll<HTMLAnchorElement>('[data-category-nav]').forEach((link) => link.addEventListener('click', () => {
        const category = link.dataset.categoryNav ?? 'all';
        const target = [...document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]')]
          .find((item) => item.dataset.category === category);
        target?.click();
        setMenuOpen(false);
      }));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false);
      });
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        sectionLinks.forEach((link) => {
          const active = link.hash === `#${visible.target.id}`;
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-18% 0px -70% 0px', threshold: [0, .15, .5] });
      document.querySelectorAll<HTMLElement>('main > section[id]').forEach((section) => sectionObserver.observe(section));
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== search) {
          event.preventDefault();
          if (search instanceof HTMLInputElement) search.focus();
        }
      });

      applyTranslations(localStorage.getItem('awesome-jev-language') === 'zh' ? 'zh' : 'en');
      render();
    </script>
  </body>
</html>

---
import '../styles/global.css';
import { catalogStats, getCatalog } from '../lib/catalog';
import { getLocale, getMessages, localeConfig, locales } from '../i18n';
import { getLocalePath } from '../i18n/config';
import {
  AppWindow,
  ArrowDown,
  ArrowUpRight,
  AtSign,
  BadgeCheck,
  Blocks,
  Bot,
  ChartNoAxesCombined,
  Check,
  ChevronDown,
  CircleQuestionMark,
  CirclePlus,
  FlaskConical,
  Gamepad2,
  LayoutGrid,
  ListTree,
  Mail,
  Menu,
  MonitorSmartphone,
  Search,
  Star,
  Workflow,
  X,
} from '@lucide/astro';

const base = import.meta.env.BASE_URL;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const messages = getMessages(locale);
const { categories, projects } = getCatalog(locale);
const addedDateFormatter = new Intl.DateTimeFormat(localeConfig[locale].languageTag, { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Taipei' });
const formatAddedDate = (date: string) => addedDateFormatter.format(new Date(`${date}T00:00:00+08:00`));
const repositoryUrl = process.env.GITHUB_REPOSITORY
  ? `https://github.com/${process.env.GITHUB_REPOSITORY}`
  : 'https://github.com/heyjunpenn/awesome-jev';
const submissionIssueBody = [
  '## Project',
  '- Repository URL:',
  '- Short description:',
  '',
  '## Jev usage',
  '- Evidence link (code, docs, or demo):',
  '- How does this project use Jev?',
].join('\n');
const submissionUrl = `${repositoryUrl}/issues/new?title=${encodeURIComponent('[Submission] Project name')}&body=${encodeURIComponent(submissionIssueBody)}`;
const languages = [...new Set(projects.map((project) => project.language).filter((language) => language !== '—'))]
  .sort((a, b) => a.localeCompare(b));
const sortedProjects = [...projects].sort((a, b) => {
  const starDifference = b.stars - a.stars;
  return starDifference || a.url.localeCompare(b.url, 'en');
});
const initialProjects = sortedProjects.slice(0, 16);
const localizedCatalogUrl = `${base}catalog/${locale}.json`;
const localizedSearchText = (project: (typeof projects)[number]) =>
  [project.name, project.url, project.language, project.description].join(' ').toLowerCase();
const categoryIcons = [BadgeCheck, Blocks, Workflow, Bot, MonitorSmartphone, AppWindow, Gamepad2, FlaskConical, ChartNoAxesCombined, ListTree];
const navigationCategories = categories.map((category, index) => ({ ...category, Icon: categoryIcons[index] ?? LayoutGrid }));
const repositorySlug = (url: string) => {
  try {
    const [owner, repository] = new URL(url).pathname.split('/').filter(Boolean);
    return owner && repository ? `${owner}/${repository.replace(/\.git$/, '')}` : url;
  } catch {
    return url;
  }
};
const siteUrl = 'https://jevbest.com/';
const pageUrl = `${siteUrl}${getLocalePath(locale)}`;
const socialImageUrl = `${siteUrl}readme/awesome-jev-hero.png`;
const authorId = `${siteUrl}#author`;
const publisherId = `${siteUrl}#organization`;
const catalogId = `${siteUrl}#catalog`;
const datasetId = `${siteUrl}#projects`;
const pageTitle = messages.seo.title(catalogStats.projects);
const pageDescription = messages.seo.description(catalogStats.projects);
const alternateLocales = locales.filter((candidate) => candidate !== locale);
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      '@id': publisherId,
      name: 'bestjev',
      alternateName: 'Awesome Jev',
      url: siteUrl,
      logo: {
        '@type': 'ImageObject',
        url: `${siteUrl}favicon.png`,
        width: 512,
        height: 512,
      },
      sameAs: [repositoryUrl, 'https://x.com/heyjunpenn'],
    },
    {
      '@type': 'Person',
      '@id': authorId,
      name: 'heyjunpenn',
      url: 'https://github.com/heyjunpenn',
      sameAs: ['https://github.com/heyjunpenn', 'https://x.com/heyjunpenn'],
    },
    {
      '@type': 'WebSite',
      '@id': `${siteUrl}#website`,
      url: siteUrl,
      name: 'bestjev',
      alternateName: 'Awesome Jev',
      description: pageDescription,
      inLanguage: locales.map((candidate) => localeConfig[candidate].languageTag),
      publisher: { '@id': publisherId },
    },
    {
      '@type': 'CollectionPage',
      '@id': `${pageUrl}#webpage`,
      url: pageUrl,
      name: messages.seo.catalogName,
      alternateName: messages.seo.alternateName,
      description: pageDescription,
      isAccessibleForFree: true,
      inLanguage: localeConfig[locale].languageTag,
      dateModified: '2026-09-20',
      datePublished: '2026-09-19',
      author: { '@id': authorId },
      publisher: { '@id': publisherId },
      isPartOf: { '@id': `${siteUrl}#website` },
      keywords: ['Jev', 'TypeSafe AI', 'System One model', 'Jev SDK', 'Jev tools', 'Jev agents', 'open-source AI'],
      about: {
        '@type': 'SoftwareApplication',
        name: 'Jev',
        applicationCategory: 'DeveloperApplication',
        operatingSystem: 'Cloud API',
        url: 'https://typesafe.ai/',
      },
      mainEntity: { '@id': datasetId },
    },
    {
      '@type': 'DataCatalog',
      '@id': catalogId,
      name: 'bestjev Open-Source Project Catalog',
      alternateName: 'Awesome Jev Project Catalog',
      description: pageDescription,
      url: siteUrl,
      inLanguage: locales.map((candidate) => localeConfig[candidate].languageTag),
      publisher: { '@id': publisherId },
      dataset: { '@id': datasetId },
    },
    {
      '@type': 'Dataset',
      '@id': datasetId,
      name: 'bestjev Open-Source Project Dataset',
      alternateName: 'Awesome Jev Project Dataset',
      description: `Machine-readable metadata for ${catalogStats.projects} public repositories built around Jev.`,
      url: siteUrl,
      identifier: datasetId,
      keywords: ['Jev', 'open-source projects', 'SDKs', 'agents', 'integrations', 'developer tools'],
      license: 'https://opensource.org/license/mit',
      isAccessibleForFree: true,
      inLanguage: locales.map((candidate) => localeConfig[candidate].languageTag),
      dateModified: '2026-09-20',
      datePublished: '2026-09-19',
      creator: { '@id': authorId },
      publisher: { '@id': publisherId },
      version: '2026-09-20',
      includedInDataCatalog: {
        '@type': 'DataCatalog',
        '@id': catalogId,
        name: 'bestjev Open-Source Project Catalog',
        url: siteUrl,
      },
      distribution: {
        '@type': 'DataDownload',
        encodingFormat: 'application/json',
        contentUrl: `${siteUrl}catalog.json`,
      },
    },
  ],
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={localeConfig[locale].languageTag} data-language={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <style is:inline>@media (max-width: 1080px) { .sidebar { visibility: hidden; transform: translateX(-102%); } body.menu-open .sidebar { visibility: visible; transform: translateX(0); } }</style>
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={pageDescription} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="author" content="heyjunpenn" />
    <link rel="canonical" href={pageUrl} />
    {locales.map((candidate) => <link rel="alternate" hreflang={localeConfig[candidate].languageTag} href={`${siteUrl}${getLocalePath(candidate)}`} />)}
    <link rel="alternate" hreflang="x-default" href={siteUrl} />
    <link rel="alternate" type="application/json" title="bestjev project catalog" href={`${siteUrl}catalog.json`} />
    <link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
    <link rel="icon" type="image/png" sizes="512x512" href={`${base}favicon.png`} />
    <link rel="apple-touch-icon" href={`${base}favicon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bestjev" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={localeConfig[locale].openGraphLocale} />
    {alternateLocales.map((candidate) => <meta property="og:locale:alternate" content={localeConfig[candidate].openGraphLocale} />)}
    <meta property="og:image" content={socialImageUrl} />
    <meta property="og:image:width" content="1983" />
    <meta property="og:image:height" content="793" />
    <meta property="og:image:alt" content={messages.seo.imageAlt(catalogStats.projects, catalogStats.categories)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@heyjunpenn" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={socialImageUrl} />
    <meta name="twitter:image:alt" content={messages.seo.imageAlt(catalogStats.projects, catalogStats.categories)} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
    <script is:inline>
      (() => {
        const events = ['pointerdown', 'keydown', 'touchstart'];
        const loadAnalytics = () => {
          events.forEach((event) => window.removeEventListener(event, loadAnalytics));
          if (location.hostname === 'localhost' || location.hostname === '127.0.0.1') return;

          window.dataLayer = window.dataLayer || [];
          window.gtag = function gtag(){ window.dataLayer.push(arguments); };
          window.gtag('js', new Date());
          window.gtag('config', 'G-HV69G90WGD');

          const googleTag = document.createElement('script');
          googleTag.async = true;
          googleTag.src = 'https://www.googletagmanager.com/gtag/js?id=G-HV69G90WGD';
          document.head.append(googleTag);

          const dataFast = document.createElement('script');
          dataFast.defer = true;
          dataFast.dataset.websiteId = 'dfid_lVw0uw28br7SqwvICIeFq';
          dataFast.dataset.domain = 'jevbest.com';
          dataFast.src = 'https://datafa.st/js/script.js';
          document.head.append(dataFast);
        };

        events.forEach((event) => window.addEventListener(event, loadAnalytics, { once: true, passive: true }));
      })();
    </script>
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="app-shell">
      <aside class="sidebar" id="sidebar">
        <div class="sidebar-head">
          <a class="brand" href="#overview" aria-label={messages.nav.home}>
            <img class="brand-logo" src={`${base}brand/bestjev-logo-rounded.svg`} alt={messages.nav.logoAlt} width="136" height="34" />
          </a>
          <button class="sidebar-close" type="button" aria-label={messages.nav.close}><X size={18} stroke-width={1.8} /></button>
        </div>

        <div class="sidebar-primary">
          <nav class="side-nav primary-nav" aria-label={messages.nav.primary}>
            <a class="active" href="#projects" data-category-nav="all"><LayoutGrid class="nav-icon" size={17} stroke-width={1.8} /><span>{messages.nav.allProjects}</span><small>{catalogStats.projects}</small></a>
            <a href="#about"><CircleQuestionMark class="nav-icon" size={17} stroke-width={1.8} /><span>{messages.nav.aboutJev}</span></a>
            <a href={repositoryUrl} target="_blank" rel="noreferrer" aria-label={messages.nav.githubRepository}>
              <svg class="nav-icon github-icon" viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 .7a11.5 11.5 0 0 0-3.64 22.41c.58.11.79-.25.79-.56v-2.23c-3.22.7-3.9-1.37-3.9-1.37-.53-1.34-1.29-1.7-1.29-1.7-1.05-.72.08-.7.08-.7 1.17.08 1.78 1.2 1.78 1.2 1.04 1.78 2.72 1.27 3.39.97.1-.75.4-1.27.74-1.56-2.57-.29-5.27-1.28-5.27-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.47.11-3.06 0 0 .97-.31 3.16 1.18A10.98 10.98 0 0 1 12 6.1c.98 0 1.95.13 2.87.39 2.19-1.49 3.15-1.18 3.15-1.18.63 1.59.23 2.77.12 3.06.74.81 1.18 1.84 1.18 3.1 0 4.42-2.71 5.39-5.29 5.68.42.36.78 1.06.78 2.14v3.26c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .7Z" />
              </svg>
              <span>GitHub</span>
            </a>
          </nav>

        </div>

        <div class="sidebar-scroll">
          <div class="category-nav-head">
            <span>{messages.nav.categories}</span>
          </div>
          <nav class="category-nav" aria-label={messages.nav.projectCategories}>
            {navigationCategories.map(({ Icon, ...category }) => (
              <a href="#projects" data-category-nav={category.id}>
                <Icon class="nav-icon" size={16} stroke-width={1.75} />
                <span>{category.name}</span>
                <small>{category.count}</small>
              </a>
            ))}
          </nav>

          <div class="collaboration-nav-head">
            <span>{messages.nav.collaborate}</span>
          </div>
          <nav class="collaboration-nav" aria-label={messages.nav.collaborateLabel}>
            <a href={submissionUrl} target="_blank" rel="noreferrer" aria-label={messages.submission.cta}>
              <CirclePlus class="nav-icon" size={16} stroke-width={1.75} />
              <span>{messages.nav.submit}</span>
              <small>GitHub issue</small>
            </a>
            <a href="https://x.com/heyjunpenn" target="_blank" rel="noreferrer" aria-label={messages.nav.xProfile}>
              <AtSign class="nav-icon" size={16} stroke-width={1.75} />
              <span>X</span>
              <small>@heyjunpenn</small>
            </a>
            <a href="mailto:someuxyz@gmail.com" aria-label={messages.nav.emailMaintainer}>
              <Mail class="nav-icon" size={16} stroke-width={1.75} />
              <span>{messages.nav.email}</span>
              <small>someuxyz@gmail.com</small>
            </a>
          </nav>

          <div class="collaboration-placement">
            <strong>{messages.nav.promote}</strong>
            <a href="mailto:someuxyz@gmail.com?subject=Awesome%20Jev%20placement" aria-label={messages.nav.promoteEmail}>
              <span>someuxyz@gmail.com</span>
              <ArrowUpRight size={14} stroke-width={1.8} aria-hidden="true" />
            </a>
          </div>

        </div>

        <div class="sidebar-foot">
          <div class="locale-picker" data-locale-picker>
            <button class="locale-trigger" type="button" aria-label={messages.nav.language} aria-haspopup="listbox" aria-expanded="false" aria-controls="locale-options">
              <img src={`${base}flags/${localeConfig[locale].flag}.svg`} alt={messages.nav.flagAlt(localeConfig[locale].label)} aria-hidden="true" width="28" height="20" />
              <span>{localeConfig[locale].label}</span>
              <ChevronDown size={15} stroke-width={1.8} aria-hidden="true" />
            </button>
            <div class="locale-menu" id="locale-options" role="listbox" aria-label={messages.nav.language} hidden>
              {locales.map((candidate) => (
                <a
                  class:list={['locale-option', candidate === locale && 'selected']}
                  href={`${base}${getLocalePath(candidate)}`}
                  lang={localeConfig[candidate].languageTag}
                  hreflang={localeConfig[candidate].languageTag}
                  role="option"
                  aria-selected={candidate === locale ? 'true' : 'false'}
                  aria-current={candidate === locale ? 'page' : undefined}
                >
                  <img src={`${base}flags/${localeConfig[candidate].flag}.svg`} alt={messages.nav.flagAlt(localeConfig[candidate].label)} aria-hidden="true" width="28" height="20" />
                  <span>{localeConfig[candidate].label}</span>
                  <Check size={14} stroke-width={2} aria-hidden="true" />
                </a>
              ))}
            </div>
          </div>
        </div>
      </aside>

      <main>
        <header class="mobile-header">
          <a class="brand" href="#overview" aria-label={messages.nav.home}><img class="brand-logo" src={`${base}brand/bestjev-logo-rounded.svg`} alt={messages.nav.logoAlt} width="136" height="34" /></a>
          <button class="menu-button" type="button" aria-label={messages.nav.open} aria-controls="sidebar" aria-expanded="false"><Menu size={19} stroke-width={1.8} /></button>
        </header>
        <button class="nav-scrim" type="button" aria-label={messages.nav.close} tabindex="-1"></button>

        <section class="hero" id="overview">
          <div class="hero-shell">
            <div class="hero-copy">
              <h1>{messages.hero.title}</h1>
              <p>{messages.hero.summary(catalogStats.projects, catalogStats.categories, catalogStats.languages)}</p>
              <div class="hero-updated"><span>{messages.hero.lastUpdated}</span><time datetime="2026-09-21">{messages.hero.updatedDate}</time></div>
              <div class="recency-filters" role="group" aria-label={messages.hero.clearRecency} data-today={catalogStats.today} data-week-start={catalogStats.weekStartsOn}>
                <button type="button" data-recency="today" aria-pressed="false" aria-controls="project-table">
                  <span>{messages.hero.addedToday}</span><strong>+{catalogStats.addedToday}</strong>
                </button>
                <button type="button" data-recency="week" aria-pressed="false" aria-controls="project-table">
                  <span>{messages.hero.addedThisWeek}</span><strong>+{catalogStats.addedThisWeek}</strong>
                </button>
              </div>
              <div class="filter-panel filter-dock">
                <div class="language-picker" data-language-picker>
                  <button class="language-trigger" id="language-filter" type="button" aria-label={messages.hero.filterLanguage} aria-haspopup="listbox" aria-expanded="false" aria-controls="language-options">
                    <span data-language-label>{messages.hero.allLanguages}</span>
                    <ChevronDown class="language-chevron" size={15} stroke-width={1.8} aria-hidden="true" />
                  </button>
                  <div class="language-menu" id="language-options" role="listbox" aria-label={messages.hero.languages} hidden>
                    <button class="language-option" type="button" role="option" data-language-value="all" aria-selected="true">
                      <span>{messages.hero.allLanguages}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                    </button>
                    {languages.map((language) => (
                      <button class="language-option" type="button" role="option" data-language-value={language} aria-selected="false">
                        <span>{language}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                      </button>
                    ))}
                  </div>
                </div>
                <label class="search-box">
                  <span aria-hidden="true"><Search size={18} stroke-width={1.8} /></span>
                  <input id="project-search" type="search" placeholder={messages.hero.searchPlaceholder} autocomplete="off" />
                  <kbd>/</kbd>
                </label>
                <a class="submit-project-shortcut" href={submissionUrl} target="_blank" rel="noreferrer">
                  <CirclePlus size={17} stroke-width={1.9} aria-hidden="true" />
                  <span>{messages.submission.shortCta}</span>
                </a>
              </div>
            </div>

            <figure class="hero-illustration">
              <img src={`${base}jev-decision-flow.svg`} width="760" height="500" alt={messages.hero.imageAlt} fetchpriority="high" />
            </figure>
          </div>
        </section>

        <div class="catalog-region">
          <section class="catalog" id="projects">
            <div class="category-strip" role="group" aria-label={messages.nav.projectCategories}>
              <h2 class="category-heading">
                <button class="category-button selected" type="button" data-category="all"><span>{messages.catalog.all}</span><b>{projects.length}</b></button>
              </h2>
              <span class="filter-divider" aria-hidden="true"></span>
              <div class="recency-filters catalog-recency-filters" role="group" aria-label={messages.hero.clearRecency} data-today={catalogStats.today} data-week-start={catalogStats.weekStartsOn}>
                <button type="button" data-recency="today" aria-pressed="false" aria-controls="project-table">
                  <span>{messages.hero.addedToday}</span><strong>+{catalogStats.addedToday}</strong>
                </button>
                <button type="button" data-recency="week" aria-pressed="false" aria-controls="project-table">
                  <span>{messages.hero.addedThisWeek}</span><strong>+{catalogStats.addedThisWeek}</strong>
                </button>
              </div>
              <span class="filter-divider" aria-hidden="true"></span>
              {categories.map((category) => (
                <button class="category-button" type="button" data-category={category.id}>
                  <span>{category.name}</span>
                  <b>{category.count}</b>
                </button>
              ))}
            </div>

            <div class="table-heading">
              <span>{messages.catalog.project}</span>
              <span class="star-heading">
                <button
                  class="sort-button"
                  id="star-sort"
                  type="button"
                  data-direction="desc"
                  data-label-ascending={messages.catalog.sortAscending}
                  data-label-descending={messages.catalog.sortDescending}
                  aria-label={messages.catalog.sortAscending}
                >{messages.catalog.stars}<ArrowDown size={13} stroke-width={1.9} aria-hidden="true" /></button>
              </span>
              <span>{messages.catalog.language}</span>
              <span>{messages.catalog.addedAt}</span>
              <span>{messages.catalog.description}</span>
            </div>
            <ol class="project-table" id="project-table" aria-label={messages.catalog.projectsLabel} data-catalog-url={localizedCatalogUrl}>
              {initialProjects.map((project) => (
                <li class="project-row" data-project data-stars={project.stars} data-category={project.categoryId} data-language={project.language} data-search={localizedSearchText(project)} data-added-date={project.addedDate}>
                  <a class="project-name" href={project.url} target="_blank" rel="noreferrer"><h3>{repositorySlug(project.url)}</h3><small>{project.category}</small></a>
                  <span class="stars"><Star class="star-icon" size={13} stroke-width={1.8} aria-hidden="true" />{project.starsLabel}</span>
                  <span class="project-language">{project.language}</span>
                  <time class="project-added-date" datetime={project.addedDate}>{formatAddedDate(project.addedDate)}</time>
                  <p>{project.description}</p>
                </li>
              ))}
            </ol>
            <template id="project-row-template">
              <li class="project-row" data-project>
                <a class="project-name" target="_blank" rel="noreferrer"><h3></h3><small></small></a>
                <span class="stars"><Star class="star-icon" size={13} stroke-width={1.8} aria-hidden="true" /><span data-project-stars></span></span>
                <span class="project-language"></span>
                <time class="project-added-date"></time>
                <p></p>
              </li>
            </template>

            <div class="empty-state" id="empty-state" hidden><strong>{messages.catalog.noMatches}</strong><span>{messages.catalog.noMatchesHint}</span></div>
            <button class="load-more" id="load-more" type="button"><span>{messages.catalog.showMore}</span><b>↓</b></button>
          </section>
        </div>

        <section class="site-intro" id="about-bestjev">
          <div class="site-intro-heading">
            <span>{messages.siteIntro.eyebrow}</span>
            <h2>{messages.siteIntro.title}</h2>
          </div>
          <div class="site-intro-copy">
            {messages.siteIntro.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="about" id="about">
          <div class="about-intro">
            <h2>{messages.about.title}</h2>
            <div class="about-copy">
              {messages.about.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <div class="about-note">
              <span>{messages.about.advantage}</span>
              <p>{messages.about.advantageText}</p>
            </div>
          </div>
          <div class="primitive-grid">
            {messages.about.primitives.map((primitive) => <article><span>{primitive.code}</span><h3>{primitive.title}</h3><p>{primitive.description}</p></article>)}
          </div>
        </section>

        <section class="methodology" id="methodology">
          <div>
            <h2>{messages.methodology.title}</h2>
          </div>
          <div class="methodology-copy">
            <p>{messages.methodology.intro}</p>
            <p class="catalog-byline"><span>{messages.methodology.curatedBy}</span> <a href="https://github.com/heyjunpenn" rel="author">heyjunpenn</a></p>
            <blockquote cite="https://typesafe.ai/blog/introducing-system-one-models-and-jev">
              <span>{messages.methodology.quote}</span>
              <cite>— <a href="https://typesafe.ai/blog/introducing-system-one-models-and-jev" target="_blank" rel="noreferrer">{messages.methodology.quoteSource}</a></cite>
            </blockquote>
            <h3>{messages.methodology.sourcesTitle}</h3>
            <ul>
              <li><a href="https://docs.typesafe.ai/" target="_blank" rel="noreferrer">{messages.methodology.officialDocs}</a>{messages.methodology.officialDocsSuffix}</li>
              <li><a href={repositoryUrl} target="_blank" rel="noreferrer">{messages.methodology.repositories}</a>{messages.methodology.repositoriesSuffix}</li>
              <li><a href={`${siteUrl}catalog.json`}>{messages.methodology.catalogData}</a>{messages.methodology.catalogDataSuffix}</li>
            </ul>
          </div>
        </section>

        <section class="submission" id="submit-project">
          <div class="submission-heading">
            <span>{messages.submission.eyebrow}</span>
            <h2>{messages.submission.title}</h2>
            <p>{messages.submission.intro}</p>
            <a class="submission-cta" href={submissionUrl} target="_blank" rel="noreferrer">
              <CirclePlus size={18} stroke-width={1.9} aria-hidden="true" />
              <span>{messages.submission.cta}</span>
              <ArrowUpRight size={16} stroke-width={1.9} aria-hidden="true" />
            </a>
            <small>{messages.submission.ctaHint}</small>
          </div>
          <ol class="submission-steps">
            {messages.submission.steps.map((step, index) => (
              <li>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <div><h3>{step.title}</h3><p>{step.description}</p></div>
              </li>
            ))}
          </ol>
        </section>

        <footer>
          <span>bestjev / 2026</span>
          <nav aria-label={messages.footer.label}>
            <a href="#about-bestjev">{messages.footer.about}</a>
            <a href="mailto:someuxyz@gmail.com">{messages.footer.contact}</a>
            <a href={`${base}privacy/`}>{messages.footer.privacy}</a>
            <a href={`${base}terms/`}>{messages.footer.terms}</a>
            <a href="https://docs.typesafe.ai/" target="_blank" rel="noreferrer"><span>{messages.footer.docs}</span> ↗</a>
          </nav>
        </footer>
      </main>
    </div>

    <script>
      type ProjectRecord = {
        name: string;
        url: string;
        stars: number;
        starsLabel: string;
        language: string;
        description: string;
        categoryId: string;
        category: string;
        searchText: string;
        addedAt: string;
        addedDate: string;
      };

      const search = document.querySelector<HTMLInputElement>('#project-search');
      const languagePicker = document.querySelector<HTMLElement>('[data-language-picker]');
      const languageFilter = document.querySelector<HTMLButtonElement>('#language-filter');
      const languageMenu = document.querySelector<HTMLElement>('#language-options');
      const languageLabel = document.querySelector<HTMLElement>('[data-language-label]');
      const languageOptions = [...document.querySelectorAll<HTMLButtonElement>('[data-language-value]')];
      const localePicker = document.querySelector<HTMLElement>('[data-locale-picker]');
      const localeTrigger = localePicker?.querySelector<HTMLButtonElement>('.locale-trigger');
      const localeMenu = localePicker?.querySelector<HTMLElement>('.locale-menu');
      const localeOptions = [...(localePicker?.querySelectorAll<HTMLAnchorElement>('.locale-option') ?? [])];
      const projectTable = document.querySelector<HTMLOListElement>('#project-table');
      const projectRowTemplate = document.querySelector<HTMLTemplateElement>('#project-row-template');
      const addedDateFormatter = new Intl.DateTimeFormat(document.documentElement.lang || 'en', { year: 'numeric', month: 'short', day: 'numeric', timeZone: 'Asia/Taipei' });
      const starSort = document.querySelector<HTMLButtonElement>('#star-sort');
      const recencyFilters = document.querySelector<HTMLElement>('.recency-filters');
      const recencyButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-recency]')];
      const loadMore = document.querySelector('#load-more');
      const emptyState = document.querySelector('#empty-state');
      const menuButton = document.querySelector('.menu-button');
      const sidebarClose = document.querySelector('.sidebar-close');
      const navScrim = document.querySelector('.nav-scrim');
      const sidebar = document.querySelector('#sidebar');
      const compactLayout = window.matchMedia('(max-width: 1080px)');
      const getPageSize = () => compactLayout.matches ? 16 : 36;
      let activeCategory = 'all';
      let selectedLanguage = 'all';
      let selectedRecency: 'all' | 'today' | 'week' = 'all';
      let starSortDirection: 'asc' | 'desc' = 'desc';
      let visibleLimit = getPageSize();

      const initialProjects = [...document.querySelectorAll<HTMLElement>('[data-project]')].map((row): ProjectRecord => ({
        name: row.querySelector('h3')?.textContent ?? '',
        url: row.querySelector<HTMLAnchorElement>('.project-name')?.href ?? '',
        stars: Number(row.dataset.stars ?? 0),
        starsLabel: row.querySelector('.stars')?.textContent?.trim() ?? '0',
        language: row.dataset.language ?? '—',
        description: row.querySelector('p')?.textContent ?? '',
        categoryId: row.dataset.category ?? '',
        category: row.querySelector('.project-name small')?.textContent ?? '',
        searchText: row.dataset.search ?? '',
        addedAt: '',
        addedDate: row.dataset.addedDate ?? '',
      }));
      let projectRecords = initialProjects;
      let catalogPromise: Promise<ProjectRecord[]> | undefined;

      const loadCatalog = () => {
        if (catalogPromise) return catalogPromise;
        const url = projectTable?.dataset.catalogUrl;
        if (!url) return Promise.resolve(projectRecords);
        catalogPromise = fetch(url)
          .then((response) => {
            if (!response.ok) throw new Error(`Catalog request failed: ${response.status}`);
            return response.json() as Promise<{ projects: ProjectRecord[] }>;
          })
          .then((payload) => {
            projectRecords = payload.projects;
            return projectRecords;
          })
          .catch(() => projectRecords);
        return catalogPromise;
      };

      const updateSortState = () => {
        starSort?.setAttribute('data-direction', starSortDirection);
        if (starSort) {
          starSort.setAttribute('aria-label', starSortDirection === 'desc'
            ? starSort.dataset.labelAscending ?? ''
            : starSort.dataset.labelDescending ?? '');
        }
      };

      const createProjectRow = (project: ProjectRecord) => {
        const fragment = projectRowTemplate?.content.cloneNode(true);
        const row = fragment instanceof DocumentFragment
          ? fragment.querySelector<HTMLElement>('[data-project]')
          : null;
        if (!row) return null;

        row.dataset.stars = String(project.stars);
        row.dataset.category = project.categoryId;
        row.dataset.language = project.language;
        row.dataset.search = project.searchText;
        row.dataset.addedDate = project.addedDate;
        const link = row.querySelector<HTMLAnchorElement>('.project-name');
        if (link) link.href = project.url;
        const name = row.querySelector('h3');
        const category = row.querySelector('.project-name small');
        const stars = row.querySelector('[data-project-stars]');
        const language = row.querySelector('.project-language');
        const addedDate = row.querySelector<HTMLTimeElement>('.project-added-date');
        const description = row.querySelector('p');
        if (name) name.textContent = project.name;
        if (category) category.textContent = project.category;
        if (stars) stars.textContent = project.starsLabel;
        if (language) language.textContent = project.language;
        if (addedDate) {
          addedDate.dateTime = project.addedDate;
          addedDate.textContent = addedDateFormatter.format(new Date(`${project.addedDate}T00:00:00+08:00`));
        }
        if (description) description.textContent = project.description;
        return row;
      };

      const render = () => {
        const query = search instanceof HTMLInputElement ? search.value.trim().toLowerCase() : '';
        const matches = [...projectRecords].sort((a, b) => {
          const difference = a.stars - b.stars;
          if (difference !== 0) return starSortDirection === 'desc' ? -difference : difference;
          return a.name.localeCompare(b.name, 'en');
        }).filter((project) => {
          const categoryMatch = activeCategory === 'all' || project.categoryId === activeCategory;
          const languageMatch = selectedLanguage === 'all' || project.language === selectedLanguage;
          const today = recencyFilters?.dataset.today ?? '';
          const weekStart = recencyFilters?.dataset.weekStart ?? '';
          const recencyMatch = selectedRecency === 'all'
            || (selectedRecency === 'today' && project.addedDate === today)
            || (selectedRecency === 'week' && project.addedDate >= weekStart && project.addedDate <= today);
          const searchMatch = !query || project.searchText.includes(query);
          return categoryMatch && languageMatch && recencyMatch && searchMatch;
        });

        const fragment = document.createDocumentFragment();
        matches.slice(0, visibleLimit).forEach((project) => {
          const row = createProjectRow(project);
          if (row) fragment.append(row);
        });
        projectTable?.replaceChildren(fragment);
        if (loadMore instanceof HTMLButtonElement) loadMore.hidden = matches.length <= visibleLimit;
        if (emptyState instanceof HTMLElement) emptyState.hidden = matches.length !== 0;
      };

      const loadAndRender = () => { void loadCatalog().then(render); };

      const setLanguageMenuOpen = (open: boolean, focusOption = false) => {
        if (!(languageFilter instanceof HTMLButtonElement) || !(languageMenu instanceof HTMLElement)) return;
        languageFilter.setAttribute('aria-expanded', String(open));
        languageMenu.hidden = !open;
        if (open && focusOption) {
          (languageOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? languageOptions[0])?.focus();
        }
      };

      const selectLanguage = (option: HTMLButtonElement) => {
        selectedLanguage = option.dataset.languageValue ?? 'all';
        if (languageLabel) languageLabel.textContent = option.querySelector('span')?.textContent ?? option.textContent?.trim() ?? '';
        languageOptions.forEach((item) => item.setAttribute('aria-selected', String(item === option)));
        visibleLimit = getPageSize();
        setLanguageMenuOpen(false);
        loadAndRender();
        languageFilter?.focus();
      };

      const setLocaleMenuOpen = (open: boolean, focusOption = false) => {
        if (!(localeTrigger instanceof HTMLButtonElement) || !(localeMenu instanceof HTMLElement)) return;
        localeTrigger.setAttribute('aria-expanded', String(open));
        localeMenu.hidden = !open;
        if (open && focusOption) {
          (localeOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? localeOptions[0])?.focus();
        }
      };

      document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]').forEach((button) => button.addEventListener('click', () => {
        activeCategory = button.dataset.category ?? 'all';
        visibleLimit = getPageSize();
        document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]').forEach((item) => item.classList.toggle('selected', item === button));
        document.querySelectorAll<HTMLAnchorElement>('.category-nav [data-category-nav]').forEach((item) => {
          const selected = item.dataset.categoryNav === activeCategory;
          item.classList.toggle('selected', selected);
          if (selected) item.setAttribute('aria-current', 'true');
          else item.removeAttribute('aria-current');
        });
        loadAndRender();
      }));
      search?.addEventListener('input', () => { visibleLimit = getPageSize(); loadAndRender(); });
      const selectRecency = (value: 'today' | 'week') => {
        selectedRecency = selectedRecency === value ? 'all' : value;
        recencyButtons.forEach((item) => item.setAttribute('aria-pressed', String(item.dataset.recency === selectedRecency)));
        visibleLimit = getPageSize();
        loadAndRender();
      };
      recencyButtons.forEach((button) => button.addEventListener('click', () => {
        selectRecency(button.dataset.recency === 'today' ? 'today' : 'week');
      }));
      starSort?.addEventListener('click', () => {
        starSortDirection = starSortDirection === 'desc' ? 'asc' : 'desc';
        visibleLimit = getPageSize();
        updateSortState();
        loadAndRender();
      });
      languageFilter?.addEventListener('click', () => setLanguageMenuOpen(languageFilter.getAttribute('aria-expanded') !== 'true'));
      languageFilter?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          setLanguageMenuOpen(true, true);
        } else if (event.key === 'Escape') {
          setLanguageMenuOpen(false);
        }
      });
      languageOptions.forEach((option, index) => {
        option.addEventListener('click', () => selectLanguage(option));
        option.addEventListener('keydown', (event) => {
          if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
            event.preventDefault();
            const offset = event.key === 'ArrowDown' ? 1 : -1;
            languageOptions[(index + offset + languageOptions.length) % languageOptions.length]?.focus();
          } else if (event.key === 'Home' || event.key === 'End') {
            event.preventDefault();
            languageOptions[event.key === 'Home' ? 0 : languageOptions.length - 1]?.focus();
          } else if (event.key === 'Escape') {
            event.preventDefault();
            setLanguageMenuOpen(false);
            languageFilter?.focus();
          }
        });
      });
      localeTrigger?.addEventListener('click', () => setLocaleMenuOpen(localeTrigger.getAttribute('aria-expanded') !== 'true'));
      localeTrigger?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          setLocaleMenuOpen(true, true);
        } else if (event.key === 'Escape') {
          setLocaleMenuOpen(false);
        }
      });
      localeOptions.forEach((option, index) => option.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const offset = event.key === 'ArrowDown' ? 1 : -1;
          localeOptions[(index + offset + localeOptions.length) % localeOptions.length]?.focus();
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          localeOptions[event.key === 'Home' ? 0 : localeOptions.length - 1]?.focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          setLocaleMenuOpen(false);
          localeTrigger?.focus();
        }
      }));
      document.addEventListener('pointerdown', (event) => {
        if (languagePicker && !languagePicker.contains(event.target as Node)) setLanguageMenuOpen(false);
        if (localePicker && !localePicker.contains(event.target as Node)) setLocaleMenuOpen(false);
      });
      languagePicker?.addEventListener('focusout', () => requestAnimationFrame(() => {
        if (languagePicker && !languagePicker.contains(document.activeElement)) setLanguageMenuOpen(false);
      }));
      localePicker?.addEventListener('focusout', () => requestAnimationFrame(() => {
        if (localePicker && !localePicker.contains(document.activeElement)) setLocaleMenuOpen(false);
      }));
      loadMore?.addEventListener('click', () => { visibleLimit += getPageSize(); loadAndRender(); });
      const syncSidebarAccess = () => {
        const hidden = compactLayout.matches && !document.body.classList.contains('menu-open');
        if (sidebar instanceof HTMLElement) {
          sidebar.toggleAttribute('inert', hidden);
          if (hidden) sidebar.setAttribute('aria-hidden', 'true');
          else sidebar.removeAttribute('aria-hidden');
        }
      };
      const setMenuOpen = (open: boolean, restoreFocus = false) => {
        const shouldOpen = compactLayout.matches && open;
        if (shouldOpen && sidebar instanceof HTMLElement) {
          sidebar.removeAttribute('inert');
          sidebar.removeAttribute('aria-hidden');
        }
        document.body.classList.toggle('menu-open', shouldOpen);
        if (!shouldOpen) setLocaleMenuOpen(false);
        menuButton?.setAttribute('aria-expanded', String(shouldOpen));
        syncSidebarAccess();
        if (shouldOpen && sidebarClose instanceof HTMLButtonElement) requestAnimationFrame(() => sidebarClose.focus());
        if (!shouldOpen && restoreFocus && menuButton instanceof HTMLButtonElement) menuButton.focus();
      };
      menuButton?.addEventListener('click', () => setMenuOpen(!document.body.classList.contains('menu-open')));
      sidebarClose?.addEventListener('click', () => setMenuOpen(false, true));
      navScrim?.addEventListener('click', () => setMenuOpen(false, true));
      const sectionLinks = [...document.querySelectorAll<HTMLAnchorElement>('.primary-nav a[href^="#"]')];
      sectionLinks.forEach((link) => link.addEventListener('click', () => setMenuOpen(false)));
      document.querySelectorAll<HTMLAnchorElement>('[data-category-nav]').forEach((link) => link.addEventListener('click', () => {
        const category = link.dataset.categoryNav ?? 'all';
        const target = [...document.querySelectorAll<HTMLButtonElement>('.category-button[data-category]')]
          .find((item) => item.dataset.category === category);
        target?.click();
        setMenuOpen(false);
      }));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') setMenuOpen(false, true);
      });
      compactLayout.addEventListener('change', () => setMenuOpen(false));
      const sectionObserver = new IntersectionObserver((entries) => {
        const visible = entries
          .filter((entry) => entry.isIntersecting)
          .sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (!visible) return;
        sectionLinks.forEach((link) => {
          const active = link.hash === `#${visible.target.id}`;
          link.classList.toggle('active', active);
          if (active) link.setAttribute('aria-current', 'page');
          else link.removeAttribute('aria-current');
        });
      }, { rootMargin: '-18% 0px -70% 0px', threshold: [0, .15, .5] });
      document.querySelectorAll<HTMLElement>('#overview, #projects, #about').forEach((section) => sectionObserver.observe(section));
      document.addEventListener('keydown', (event) => {
        if (event.key === '/' && document.activeElement !== search) {
          event.preventDefault();
          if (search instanceof HTMLInputElement) search.focus();
        }
      });

      syncSidebarAccess();
      updateSortState();
      window.addEventListener('load', () => {
        void loadCatalog().then(() => {
          if (!compactLayout.matches) render();
        });
      }, { once: true });
    </script>
  </body>
</html>

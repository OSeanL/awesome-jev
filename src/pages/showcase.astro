---
import '../styles/global.css';
import '../styles/showcase.css';
import '../styles/sponsor-placements.css';
import RealtimeTraffic from '../components/RealtimeTraffic.astro';
import SearchFilterPanel from '../components/SearchFilterPanel.astro';
import SiteHero from '../components/SiteHero.astro';
import SiteLayout from '../components/SiteLayout.astro';
import SponsorPlacements from '../components/SponsorPlacements.astro';
import StarHistoryChart from '../components/StarHistoryChart.astro';
import showcaseManifest from '../data/showcase.json';
import { defaultLocale, getLocale, getMessages, localeConfig, locales } from '../i18n';
import { getLocalePath } from '../i18n/config';
import {
  getShowcaseCategoryLabel,
  getShowcaseCategorySeo,
  getShowcaseMessages,
  getShowcaseRecencySeo,
  showcaseCategoryDefinitions,
} from '../i18n/showcase';
import { catalogStats } from '../lib/catalog';
import { filterShowcaseVideos, resolveShowcaseFilter } from '../lib/showcase-filter';
import { getShowcaseFeedPage, SHOWCASE_PAGE_SIZE } from '../lib/showcase-feed';
import { getShowcaseStats } from '../lib/showcase-stats';
import {
  ArrowLeft,
  ArrowRight,
  ArrowUpRight,
  Check,
  ChevronDown,
  CirclePlus,
  Play,
  X,
} from '@lucide/astro';

type ShowcaseVideo = {
  id: string;
  title: string;
  description: string;
  descriptions: Record<(typeof locales)[number], string>;
  postText: string;
  category: string;
  language: string;
  creator: { handle: string; name: string };
  publishedAt: string;
  sourceUrl: string;
  videoUrl: string;
  posterUrl: string;
  duration: number;
  width: number;
  height: number;
  aspectRatio: number;
  tags: string[];
};

type ShowcaseManifest = {
  schemaVersion: number;
  updatedAt: string;
  count: number;
  categories: string[];
  videos: ShowcaseVideo[];
};

const categoryFallback = ['游戏', '效率工具', '内容营销', '数据分析', '编程开发', '自动化', '任务分配', '安全审核', '金融交易', '硬件设备'];
const manifest = showcaseManifest as ShowcaseManifest;
const manifestError = manifest.videos.length === 0;
if (manifest.categories.length === 0) manifest.categories = categoryFallback;

const base = import.meta.env.BASE_URL;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const copy = getShowcaseMessages(locale);
const messages = getMessages(locale);
const repositoryUrl = process.env.GITHUB_REPOSITORY
  ? `https://github.com/${process.env.GITHUB_REPOSITORY}`
  : 'https://github.com/heyjunpenn/awesome-jev';
const submissionIssueBody = [
  '## Project',
  '- Repository URL:',
  '- Short description:',
  '',
  '## Jev usage',
  '- Evidence link (code, docs, or demo):',
  '- How does this project use Jev?',
].join('\n');
const submissionUrl = `${repositoryUrl}/issues/new?title=${encodeURIComponent('[Submission] Project name')}&body=${encodeURIComponent(submissionIssueBody)}`;
const requestedFilterSlug = typeof Astro.props.filter === 'string'
  ? Astro.props.filter
  : typeof Astro.props.category === 'string'
    ? Astro.props.category
    : undefined;
const activeFilter = resolveShowcaseFilter(requestedFilterSlug, showcaseCategoryDefinitions);
const activeCategoryId = activeFilter.type === 'category' ? activeFilter.categoryId : undefined;
const activeRecency = activeFilter.type === 'recency' ? activeFilter.slug : undefined;
const localizedVideos = filterShowcaseVideos(manifest.videos, activeFilter, {
  today: catalogStats.today,
  weekStartsOn: catalogStats.weekStartsOn,
});
const initialFeed = getShowcaseFeedPage(manifest.videos, {
  locale,
  filterSlug: activeFilter.slug || undefined,
  offset: 0,
  limit: SHOWCASE_PAGE_SIZE,
  today: catalogStats.today,
  weekStartsOn: catalogStats.weekStartsOn,
});
const siteUrl = 'https://jevbest.com/';
const showcasePath = (targetLocale = locale, filterSlug = activeFilter.slug) =>
  `${getLocalePath(targetLocale)}showcase/${filterSlug ? `${filterSlug}/` : ''}`;
const pageUrl = `${siteUrl}${showcasePath()}`;
const categoryCounts = new Map(
  manifest.categories.map((category) => [
    category,
    manifest.videos.filter((video) => video.category === category).length,
  ]),
);
const activeCategorySeo = activeCategoryId
  ? getShowcaseCategorySeo(locale, activeCategoryId, localizedVideos.length)
  : undefined;
const activeRecencySeo = activeRecency
  ? getShowcaseRecencySeo(locale, activeRecency, localizedVideos.length)
  : undefined;
const activePageSeo = activeCategorySeo ?? activeRecencySeo;
const pageTitle = activePageSeo?.title ?? copy.pageTitle;
const pageDescription = activePageSeo?.description ?? copy.pageDescription;
const heroTitle = activePageSeo?.heroTitle ?? copy.heroTitle;
const heroSummary = activePageSeo?.description ?? copy.heroSummary;
const pageKeywords = activeCategorySeo
  ? [
      `Jev ${activeCategorySeo.name}`,
      `${activeCategorySeo.name} Jev demos`,
      `${activeCategorySeo.name} Jev use cases`,
      activeCategorySeo.environment,
      'Jev Showcase',
      'TypeSafe AI Jev',
    ]
  : activeRecency
    ? [`Jev demos ${activeRecency}`, 'latest Jev demos', 'Jev Showcase', 'TypeSafe AI Jev']
    : ['Jev Showcase', 'Jev demos', 'Jev use cases', 'TypeSafe AI Jev'];
const sidebarShowcaseCategories = showcaseCategoryDefinitions.map((category) => ({
  id: category.id,
  slug: category.slug,
  name: getShowcaseCategoryLabel(locale, category.id),
  count: categoryCounts.get(category.sourceCategory) ?? 0,
}));
const showcaseStats = getShowcaseStats(manifest.videos, {
  today: catalogStats.today,
  weekStartsOn: catalogStats.weekStartsOn,
  updatedAt: manifest.updatedAt,
});
const updatedDateFormatter = new Intl.DateTimeFormat(localeConfig[locale].languageTag, {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'Asia/Taipei',
});
const formattedUpdatedAt = updatedDateFormatter.format(new Date(showcaseStats.updatedAt));
const showcaseVideos = initialFeed.items;
const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle,
  description: pageDescription,
  url: pageUrl,
  inLanguage: localeConfig[locale].languageTag,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: initialFeed.total,
    itemListElement: showcaseVideos.map((video, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      item: {
        '@type': 'VideoObject',
        name: video.title,
        description: video.description,
        thumbnailUrl: video.posterUrl,
        contentUrl: video.videoUrl,
        uploadDate: video.publishedAt,
        duration: `PT${Math.round(video.duration)}S`,
        url: video.sourceUrl,
        author: {
          '@type': 'Person',
          name: video.creator.name,
          alternateName: `@${video.creator.handle}`,
        },
      },
    })),
  },
};
const structuredDataJson = JSON.stringify(structuredData).replace(/</g, '\\u003c');
---

<!doctype html>
<html lang={localeConfig[locale].languageTag} data-language={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <style is:inline>@media (max-width: 1080px) { .sidebar { visibility: hidden; transform: translateX(-102%); } body.menu-open .sidebar { visibility: visible; transform: translateX(0); } }</style>
    <meta name="theme-color" content="#f7f7f5" />
    <meta name="description" content={pageDescription} />
    <meta name="keywords" content={pageKeywords.join(', ')} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <link rel="canonical" href={pageUrl} />
    {locales.map((candidate) => <link rel="alternate" hreflang={localeConfig[candidate].languageTag} href={`${siteUrl}${showcasePath(candidate)}`} />)}
    <link rel="alternate" hreflang="x-default" href={`${siteUrl}${showcasePath(defaultLocale)}`} />
    <link rel="icon" type="image/x-icon" sizes="16x16 32x32 48x48" href={`${base}favicon.ico`} />
    <link rel="icon" type="image/png" sizes="96x96" href={`${base}favicon-96x96.png`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="bestjev" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={pageDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:locale" content={localeConfig[locale].openGraphLocale} />
    {locales.filter((candidate) => candidate !== locale).map((candidate) => <meta property="og:locale:alternate" content={localeConfig[candidate].openGraphLocale} />)}
    <meta property="og:image" content={localizedVideos[0]?.posterUrl ?? 'https://jevbest.com/readme/awesome-jev-hero.png'} />
    <meta property="og:image:alt" content={pageTitle} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content={localizedVideos[0]?.posterUrl ?? 'https://jevbest.com/readme/awesome-jev-hero.png'} />
    <meta name="twitter:image:alt" content={pageTitle} />
    <script is:inline type="application/ld+json" set:html={structuredDataJson}></script>
    <title>{pageTitle}</title>
  </head>
  <body
    class="showcase-body"
    data-video-label={copy.videoLabel}
    data-video-error={copy.videoLoadError}
    data-showcase-root={`${base}${showcasePath(locale, '')}`}
    data-route-filtered={activeFilter.type !== 'all' ? 'true' : 'false'}
    data-showcase-filter={activeFilter.slug}
  >
    <div class="app-shell">
      <SiteLayout
        locale={locale}
        activeSection="showcase"
        showcaseCount={manifest.videos.length}
        showcaseCategories={sidebarShowcaseCategories}
        activeShowcaseCategory={activeCategoryId}
        activeShowcaseFilter={activeFilter.slug || undefined}
        mainClass="showcase-main"
      >

        <SiteHero title={heroTitle} summary={heroSummary} id="showcase" titleId="showcase-title" className="showcase-hero" filtered={activeFilter.type !== 'all'}>
          <Fragment slot="copy-extra">
            <div class="hero-updated"><span>{messages.hero.lastUpdated}</span><time datetime={showcaseStats.updatedAt}>{formattedUpdatedAt}</time></div>
            <div class="recency-filters" role="group" aria-label={copy.filtersLabel}>
              <a href={`${base}${showcasePath(locale, 'today')}`} aria-current={activeRecency === 'today' ? 'page' : undefined}>
                <span>{messages.hero.addedToday}</span><strong>+{showcaseStats.addedToday}</strong>
              </a>
              <a href={`${base}${showcasePath(locale, 'this-week')}`} aria-current={activeRecency === 'this-week' ? 'page' : undefined}>
                <span>{messages.hero.addedThisWeek}</span><strong>+{showcaseStats.addedThisWeek}</strong>
              </a>
            </div>
            <SearchFilterPanel searchId="showcase-search" placeholder={copy.searchPlaceholder} hasAction>
              <div class="language-picker" data-showcase-category-picker slot="picker">
                <button class="language-trigger" id="showcase-category-filter" type="button" aria-label={copy.filterCategory} aria-haspopup="listbox" aria-expanded="false" aria-controls="showcase-category-options">
                  <span data-showcase-category-label>{activeCategorySeo?.name ?? copy.allCategories}</span>
                  <ChevronDown class="language-chevron" size={15} stroke-width={1.8} aria-hidden="true" />
                </button>
                <div class="language-menu" id="showcase-category-options" role="listbox" aria-label={copy.categoryLabel} hidden>
                  <a class="language-option" href={`${base}${getLocalePath(locale)}showcase/`} role="option" aria-selected={activeFilter.type === 'all' ? 'true' : 'false'}>
                    <span>{copy.allCategories}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                  </a>
                  {sidebarShowcaseCategories.map((category) => (
                    <a class="language-option" href={`${base}${getLocalePath(locale)}showcase/${category.slug}/`} role="option" aria-selected={activeCategoryId === category.id ? 'true' : 'false'}>
                      <span>{category.name}</span><Check class="option-check" size={14} stroke-width={2} aria-hidden="true" />
                    </a>
                  ))}
                </div>
              </div>
              <a class="submit-project-shortcut" slot="action" href={submissionUrl} title={messages.submission.shortCta} target="_blank" rel="noreferrer">
                <CirclePlus size={17} stroke-width={1.9} aria-hidden="true" />
                <span>{messages.submission.shortCta}</span>
              </a>
            </SearchFilterPanel>
          </Fragment>
          <Fragment slot="visual">
            <StarHistoryChart alt={messages.hero.imageAlt} className="showcase-hero-media" />
            <RealtimeTraffic />
          </Fragment>
        </SiteHero>

        <section class="showcase-controls" aria-label={copy.filtersLabel}>
          <div class="category-strip showcase-category-strip" role="group" aria-label={copy.categoryLabel}>
            <a class:list={['category-button', activeFilter.type === 'all' && 'selected']} href={`${base}${getLocalePath(locale)}showcase/`} aria-current={activeFilter.type === 'all' ? 'page' : undefined}>
              <span>{copy.all}</span><b>{manifest.videos.length}</b>
            </a>
            <span class="filter-divider" aria-hidden="true"></span>
            <div class="recency-filters catalog-recency-filters">
              <a href={`${base}${showcasePath(locale, 'today')}`} aria-current={activeRecency === 'today' ? 'page' : undefined}>
                <span>{messages.hero.addedToday}</span><strong>+{showcaseStats.addedToday}</strong>
              </a>
              <a href={`${base}${showcasePath(locale, 'this-week')}`} aria-current={activeRecency === 'this-week' ? 'page' : undefined}>
                <span>{messages.hero.addedThisWeek}</span><strong>+{showcaseStats.addedThisWeek}</strong>
              </a>
            </div>
            <span class="filter-divider" aria-hidden="true"></span>
            {sidebarShowcaseCategories.map((category) => (
              <a
                class:list={['category-button', activeCategoryId === category.id && 'selected']}
                href={`${base}${getLocalePath(locale)}showcase/${category.slug}/`}
                aria-current={activeCategoryId === category.id ? 'page' : undefined}
              >
                <span>{category.name}</span><b>{category.count}</b>
              </a>
            ))}
          </div>
        </section>

        {manifestError ? (
          <div class="showcase-state" role="alert">
            <strong>{copy.manifestErrorTitle}</strong>
            <p>{copy.manifestErrorBody}</p>
            <button type="button" onclick="location.reload()">{copy.reload}</button>
          </div>
        ) : (
          <>
            <section class="showcase-grid" id="showcase-grid" aria-label={copy.gridLabel}>
              {showcaseVideos.map((video) => (
                <article
                  class="showcase-card"
                  data-showcase-card
                  data-video-id={video.id}
                  data-category={video.category}
                  data-published-at={video.publishedAt}
                  data-search={[video.title, video.description, video.creator.name, video.creator.handle, ...video.tags].join(' ').toLowerCase()}
                  data-dialog={JSON.stringify(video.dialogData)}
                  role="button"
                  tabindex="0"
                  aria-haspopup="dialog"
                  aria-controls="showcase-dialog"
                  aria-label={video.playLabel}
                >
                  <div
                    class="showcase-media"
                    style={`--media-ratio: ${video.width} / ${video.height}`}
                    aria-hidden="true"
                  >
                    <img src={video.posterUrl} alt="" width={video.width} height={video.height} loading="lazy" decoding="async" />
                    <span class="play-control" aria-hidden="true"><Play size={19} fill="currentColor" stroke-width={1.6} /></span>
                    <span class="duration-badge">{video.durationLabel}</span>
                    <span class="media-loading" aria-hidden="true"></span>
                  </div>
                  <div class="showcase-card-body">
                    <div class="showcase-card-tags">
                      <span>{video.categoryLabel}</span>
                      <span>{video.languageLabel}</span>
                    </div>
                    <p>{video.description}</p>
                    <div class="showcase-card-meta">
                      <span class="showcase-card-author" title={video.creator.name}>@{video.creator.handle}</span>
                      <time datetime={video.publishedAt}>{video.dateLabel}</time>
                    </div>
                  </div>
                </article>
              ))}
            </section>
            <template id="showcase-card-template">
              <article
                class="showcase-card"
                data-showcase-card
                role="button"
                tabindex="0"
                aria-haspopup="dialog"
                aria-controls="showcase-dialog"
              >
                <div class="showcase-media" aria-hidden="true">
                  <img src="" alt="" width="1" height="1" loading="lazy" decoding="async" />
                  <span class="play-control" aria-hidden="true"><Play size={19} fill="currentColor" stroke-width={1.6} /></span>
                  <span class="duration-badge"></span>
                  <span class="media-loading" aria-hidden="true"></span>
                </div>
                <div class="showcase-card-body">
                  <div class="showcase-card-tags"><span></span><span></span></div>
                  <p></p>
                  <div class="showcase-card-meta">
                    <span class="showcase-card-author"></span>
                    <time></time>
                  </div>
                </div>
              </article>
            </template>
            <div
              class="showcase-load-sentinel"
              id="showcase-load-sentinel"
              data-api={`${base}api/showcase/${locale}.json`}
              data-filter={activeFilter.slug}
              data-offset={initialFeed.nextOffset}
              data-total={initialFeed.total}
              hidden={!initialFeed.hasMore}
              aria-live="polite"
            >
              <span class="showcase-load-spinner" aria-hidden="true"></span>
              <button type="button" data-showcase-load-retry hidden>{copy.reload}</button>
            </div>
            <SponsorPlacements locale={locale} surface="showcase" />
            <div class="showcase-state" id="showcase-empty" hidden>
              <strong>{copy.emptyTitle}</strong>
              <p>{copy.emptyBody}</p>
              <button type="button" id="clear-showcase-filters">{copy.clearFilters}</button>
            </div>
          </>
        )}

      </SiteLayout>
    </div>

    <dialog class="showcase-dialog" id="showcase-dialog" aria-labelledby="showcase-dialog-title">
      <div class="showcase-dialog-shell">
        <button class="showcase-dialog-close" type="button" aria-label={copy.closeDetails} title={copy.closeDetails} data-showcase-dialog-close>
          <X size={19} stroke-width={1.8} aria-hidden="true" />
        </button>
        <div class="showcase-dialog-media">
          <video id="showcase-dialog-video" controls playsinline preload="metadata" aria-label={copy.videoLabel}></video>
          <p class="showcase-dialog-error" id="showcase-dialog-error" hidden>{copy.videoLoadError}</p>
        </div>
        <aside class="showcase-dialog-details">
          <div class="showcase-dialog-tags">
            <span id="showcase-dialog-category"></span>
            <span id="showcase-dialog-language"></span>
          </div>
          <h2 class="sr-only" id="showcase-dialog-title"></h2>
          <p class="showcase-dialog-description" id="showcase-dialog-description"></p>
          <section class="showcase-dialog-original" aria-labelledby="showcase-dialog-original-label">
            <div class="showcase-dialog-original-heading">
              <h3 id="showcase-dialog-original-label">{copy.originalPostLabel}</h3>
              <button
                type="button"
                aria-controls="showcase-dialog-post-text"
                aria-expanded="false"
                data-showcase-post-toggle
                data-expand-label={copy.expandOriginalPost}
                data-collapse-label={copy.collapseOriginalPost}
              >{copy.expandOriginalPost}</button>
            </div>
            <blockquote id="showcase-dialog-post-text"></blockquote>
          </section>
          <dl class="showcase-dialog-meta">
            <div><dt>{copy.creatorLabel}</dt><dd id="showcase-dialog-creator"></dd></div>
            <div><dt>{copy.publishedLabel}</dt><dd><time id="showcase-dialog-date"></time></dd></div>
            <div><dt>{copy.durationLabel}</dt><dd id="showcase-dialog-duration"></dd></div>
            <div><dt>{copy.resolutionLabel}</dt><dd id="showcase-dialog-resolution"></dd></div>
          </dl>
          <a class="showcase-dialog-source" id="showcase-dialog-source" href="#" target="_blank" rel="noreferrer">
            <span>{copy.source}</span><ArrowUpRight size={16} stroke-width={1.9} aria-hidden="true" />
          </a>
        </aside>
      </div>
      <div class="showcase-dialog-navigation">
        <button class="showcase-dialog-nav showcase-dialog-previous" type="button" aria-label={copy.previous} data-showcase-dialog-nav="previous">
          <ArrowLeft size={17} stroke-width={1.9} aria-hidden="true" /><span>{copy.previous}</span>
        </button>
        <button class="showcase-dialog-nav showcase-dialog-next" type="button" aria-label={copy.next} data-showcase-dialog-nav="next">
          <span>{copy.next}</span><ArrowRight size={17} stroke-width={1.9} aria-hidden="true" />
        </button>
      </div>
    </dialog>

    <script>
      import { getAdjacentShowcaseId } from '../lib/showcase-dialog';

      type ShowcaseDialogData = {
        id: string;
        title: string;
        description: string;
        postText: string;
        categoryLabel: string;
        languageLabel: string;
        creatorHandle: string;
        creatorName: string;
        publishedAt: string;
        dateLabel: string;
        sourceUrl: string;
        videoUrl: string;
        posterUrl: string;
        durationLabel: string;
        resolutionLabel: string;
      };

      type ShowcaseFeedItem = {
        id: string;
        title: string;
        description: string;
        category: string;
        categoryLabel: string;
        language: string;
        languageLabel: string;
        creator: { handle: string; name: string };
        publishedAt: string;
        dateLabel: string;
        posterUrl: string;
        durationLabel: string;
        width: number;
        height: number;
        tags: string[];
        playLabel: string;
        dialogData: ShowcaseDialogData;
      };

      type ShowcaseFeedPage = {
        offset: number;
        limit: number;
        total: number;
        nextOffset: number;
        hasMore: boolean;
        items: ShowcaseFeedItem[];
      };

      const searchInput = document.querySelector<HTMLInputElement>('#showcase-search');
      const showcaseGrid = document.querySelector<HTMLElement>('#showcase-grid');
      const cardTemplate = document.querySelector<HTMLTemplateElement>('#showcase-card-template');
      const loadSentinel = document.querySelector<HTMLElement>('#showcase-load-sentinel');
      const loadRetry = loadSentinel?.querySelector<HTMLButtonElement>('[data-showcase-load-retry]');
      const categoryPicker = document.querySelector<HTMLElement>('[data-showcase-category-picker]');
      const categoryTrigger = categoryPicker?.querySelector<HTMLButtonElement>('.language-trigger');
      const categoryMenu = categoryPicker?.querySelector<HTMLElement>('.language-menu');
      const categoryOptions = [...(categoryPicker?.querySelectorAll<HTMLAnchorElement>('.language-option') ?? [])];
      const emptyState = document.querySelector<HTMLElement>('#showcase-empty');
      const clearFilters = document.querySelector<HTMLButtonElement>('#clear-showcase-filters');
      const menuButton = document.querySelector<HTMLButtonElement>('.menu-button');
      const sidebarClose = document.querySelector<HTMLButtonElement>('.sidebar-close');
      const navScrim = document.querySelector<HTMLButtonElement>('.nav-scrim');
      const sidebar = document.querySelector<HTMLElement>('#sidebar');
      const localePicker = document.querySelector<HTMLElement>('[data-locale-picker]');
      const localeTrigger = localePicker?.querySelector<HTMLButtonElement>('.locale-trigger');
      const localeMenu = localePicker?.querySelector<HTMLElement>('.locale-menu');
      const localeOptions = [...(localePicker?.querySelectorAll<HTMLAnchorElement>('.locale-option') ?? [])];
      const showcaseDialog = document.querySelector<HTMLDialogElement>('#showcase-dialog');
      const dialogVideo = document.querySelector<HTMLVideoElement>('#showcase-dialog-video');
      const dialogTitle = document.querySelector<HTMLElement>('#showcase-dialog-title');
      const dialogDescription = document.querySelector<HTMLElement>('#showcase-dialog-description');
      const dialogPostText = document.querySelector<HTMLElement>('#showcase-dialog-post-text');
      const dialogPostSection = document.querySelector<HTMLElement>('.showcase-dialog-original');
      const dialogPostToggle = document.querySelector<HTMLButtonElement>('[data-showcase-post-toggle]');
      const dialogCategory = document.querySelector<HTMLElement>('#showcase-dialog-category');
      const dialogLanguage = document.querySelector<HTMLElement>('#showcase-dialog-language');
      const dialogCreator = document.querySelector<HTMLElement>('#showcase-dialog-creator');
      const dialogDate = document.querySelector<HTMLTimeElement>('#showcase-dialog-date');
      const dialogDuration = document.querySelector<HTMLElement>('#showcase-dialog-duration');
      const dialogResolution = document.querySelector<HTMLElement>('#showcase-dialog-resolution');
      const dialogSource = document.querySelector<HTMLAnchorElement>('#showcase-dialog-source');
      const dialogError = document.querySelector<HTMLElement>('#showcase-dialog-error');
      const dialogClose = document.querySelector<HTMLButtonElement>('[data-showcase-dialog-close]');
      const dialogNavButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-showcase-dialog-nav]')];
      const compactLayout = window.matchMedia('(max-width: 1080px)');
      let activeDialogId = '';
      let nextOffset = Number(loadSentinel?.dataset.offset ?? 0);
      let hasMore = nextOffset < Number(loadSentinel?.dataset.total ?? 0);
      let loadingPage = false;
      let requestVersion = 0;
      let activeRequest: AbortController | undefined;
      let searchTimer: ReturnType<typeof setTimeout> | undefined;

      const legacyCategory = new URLSearchParams(window.location.search).get('category');
      const legacyCategoryLink = [...document.querySelectorAll<HTMLAnchorElement>('[data-showcase-category-source]')]
        .find((link) => link.dataset.showcaseCategorySource === legacyCategory);
      if (legacyCategoryLink) window.location.replace(legacyCategoryLink.href);

      const getCards = () => [
        ...(showcaseGrid?.querySelectorAll<HTMLElement>('[data-showcase-card]') ?? []),
      ];

      const renderFeedCard = (item: ShowcaseFeedItem) => {
        const card = cardTemplate?.content.firstElementChild?.cloneNode(true) as HTMLElement | undefined;
        if (!card) return undefined;

        card.dataset.videoId = item.id;
        card.dataset.category = item.category;
        card.dataset.publishedAt = item.publishedAt;
        card.dataset.search = [
          item.title,
          item.description,
          item.creator.name,
          item.creator.handle,
          ...item.tags,
        ].join(' ').toLowerCase();
        card.dataset.dialog = JSON.stringify(item.dialogData);
        card.setAttribute('aria-label', item.playLabel);

        const media = card.querySelector<HTMLElement>('.showcase-media');
        media?.style.setProperty('--media-ratio', `${item.width} / ${item.height}`);
        const image = card.querySelector<HTMLImageElement>('.showcase-media img');
        if (image) {
          image.src = item.posterUrl;
          image.width = item.width;
          image.height = item.height;
        }
        const duration = card.querySelector<HTMLElement>('.duration-badge');
        if (duration) duration.textContent = item.durationLabel;
        const tags = card.querySelectorAll<HTMLElement>('.showcase-card-tags span');
        if (tags[0]) tags[0].textContent = item.categoryLabel;
        if (tags[1]) tags[1].textContent = item.languageLabel;
        const description = card.querySelector<HTMLElement>('.showcase-card-body > p');
        if (description) description.textContent = item.description;
        const author = card.querySelector<HTMLElement>('.showcase-card-author');
        if (author) {
          author.textContent = `@${item.creator.handle}`;
          author.title = item.creator.name;
        }
        const date = card.querySelector<HTMLTimeElement>('.showcase-card-meta time');
        if (date) {
          date.dateTime = item.publishedAt;
          date.textContent = item.dateLabel;
        }

        return card;
      };

      const setLoadState = (loading: boolean, error = false) => {
        if (!loadSentinel) return;
        loadSentinel.dataset.loading = String(loading);
        loadSentinel.toggleAttribute('data-error', error);
        if (loadRetry) loadRetry.hidden = !error;
      };

      const loadShowcasePage = async (reset = false) => {
        if (!showcaseGrid || !loadSentinel || (!hasMore && !reset)) return;
        if (loadingPage && !reset) return;

        if (reset) activeRequest?.abort();
        const version = ++requestVersion;
        const controller = new AbortController();
        activeRequest = controller;
        loadingPage = true;
        loadSentinel.hidden = false;
        setLoadState(true);

        const url = new URL(loadSentinel.dataset.api ?? '/api/showcase/en.json', window.location.origin);
        const filter = loadSentinel.dataset.filter;
        const query = searchInput?.value.trim() ?? '';
        if (filter) url.searchParams.set('filter', filter);
        if (query) url.searchParams.set('q', query);
        url.searchParams.set('offset', String(reset ? 0 : nextOffset));
        url.searchParams.set('limit', '24');

        try {
          const response = await fetch(url, {
            headers: { Accept: 'application/json' },
            signal: controller.signal,
          });
          if (!response.ok) throw new Error(`Showcase API returned ${response.status}`);
          const page = await response.json() as ShowcaseFeedPage;
          if (version !== requestVersion) return;

          const fragment = document.createDocumentFragment();
          page.items.forEach((item) => {
            const card = renderFeedCard(item);
            if (card) fragment.append(card);
          });
          if (reset) showcaseGrid.replaceChildren();
          showcaseGrid.appendChild(fragment);
          nextOffset = page.nextOffset;
          hasMore = page.hasMore;
          loadSentinel.dataset.offset = String(page.nextOffset);
          loadSentinel.dataset.total = String(page.total);
          loadSentinel.hidden = !page.hasMore;
          if (emptyState) emptyState.hidden = page.total !== 0;
          setLoadState(false);
        } catch (error) {
          if ((error as Error).name !== 'AbortError' && version === requestVersion) {
            loadSentinel.hidden = false;
            setLoadState(false, true);
          }
        } finally {
          if (version === requestVersion) loadingPage = false;
        }
      };

      const scheduleSearch = () => {
        if (searchTimer) clearTimeout(searchTimer);
        searchTimer = setTimeout(() => void loadShowcasePage(true), 250);
      };

      const loadObserver = loadSentinel && 'IntersectionObserver' in window
        ? new IntersectionObserver((entries) => {
          if (entries.some((entry) => entry.isIntersecting)) void loadShowcasePage();
        }, { rootMargin: '800px 0px' })
        : undefined;
      if (loadSentinel) loadObserver?.observe(loadSentinel);
      loadRetry?.addEventListener('click', () => void loadShowcasePage());

      const setCategoryMenuOpen = (open: boolean, focusOption = false) => {
        if (!categoryTrigger || !categoryMenu) return;
        categoryTrigger.setAttribute('aria-expanded', String(open));
        categoryMenu.hidden = !open;
        if (open && focusOption) {
          (categoryOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? categoryOptions[0])?.focus();
        }
      };

      const setLocaleMenuOpen = (open: boolean, focusOption = false) => {
        if (!localeTrigger || !localeMenu) return;
        localeTrigger.setAttribute('aria-expanded', String(open));
        localeMenu.hidden = !open;
        if (open && focusOption) {
          (localeOptions.find((option) => option.getAttribute('aria-selected') === 'true') ?? localeOptions[0])?.focus();
        }
      };

      const syncSidebarAccess = () => {
        const hidden = compactLayout.matches && !document.body.classList.contains('menu-open');
        if (!sidebar) return;
        sidebar.toggleAttribute('inert', hidden);
        if (hidden) sidebar.setAttribute('aria-hidden', 'true');
        else sidebar.removeAttribute('aria-hidden');
      };

      const setMenuOpen = (open: boolean, restoreFocus = false) => {
        const shouldOpen = compactLayout.matches && open;
        if (shouldOpen) {
          sidebar?.removeAttribute('inert');
          sidebar?.removeAttribute('aria-hidden');
        }
        document.body.classList.toggle('menu-open', shouldOpen);
        menuButton?.setAttribute('aria-expanded', String(shouldOpen));
        if (!shouldOpen) {
          setLocaleMenuOpen(false);
          setCategoryMenuOpen(false);
        }
        syncSidebarAccess();
        if (shouldOpen) requestAnimationFrame(() => sidebarClose?.focus());
        if (!shouldOpen && restoreFocus) menuButton?.focus();
      };

      searchInput?.addEventListener('input', scheduleSearch);
      clearFilters?.addEventListener('click', () => {
        if (searchInput?.value) {
          searchInput.value = '';
          void loadShowcasePage(true);
          searchInput.focus();
          return;
        }
        if (document.body.dataset.routeFiltered === 'true') {
          window.location.assign(document.body.dataset.showcaseRoot ?? '/showcase/');
        }
      });
      menuButton?.addEventListener('click', () => setMenuOpen(!document.body.classList.contains('menu-open')));
      sidebarClose?.addEventListener('click', () => setMenuOpen(false, true));
      navScrim?.addEventListener('click', () => setMenuOpen(false, true));
      compactLayout.addEventListener('change', () => setMenuOpen(false));
      categoryTrigger?.addEventListener('click', () => setCategoryMenuOpen(categoryTrigger.getAttribute('aria-expanded') !== 'true'));
      categoryTrigger?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          setCategoryMenuOpen(true, true);
        } else if (event.key === 'Escape') {
          setCategoryMenuOpen(false);
        }
      });
      categoryOptions.forEach((option, index) => option.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const offset = event.key === 'ArrowDown' ? 1 : -1;
          categoryOptions[(index + offset + categoryOptions.length) % categoryOptions.length]?.focus();
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          categoryOptions[event.key === 'Home' ? 0 : categoryOptions.length - 1]?.focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          setCategoryMenuOpen(false);
          categoryTrigger?.focus();
        }
      }));
      localeTrigger?.addEventListener('click', () => setLocaleMenuOpen(localeTrigger.getAttribute('aria-expanded') !== 'true'));
      localeTrigger?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          setLocaleMenuOpen(true, true);
        } else if (event.key === 'Escape') {
          setLocaleMenuOpen(false);
        }
      });
      localeOptions.forEach((option, index) => option.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const offset = event.key === 'ArrowDown' ? 1 : -1;
          localeOptions[(index + offset + localeOptions.length) % localeOptions.length]?.focus();
        } else if (event.key === 'Home' || event.key === 'End') {
          event.preventDefault();
          localeOptions[event.key === 'Home' ? 0 : localeOptions.length - 1]?.focus();
        } else if (event.key === 'Escape') {
          event.preventDefault();
          setLocaleMenuOpen(false);
          localeTrigger?.focus();
        }
      }));
      document.addEventListener('pointerdown', (event) => {
        if (categoryPicker && !categoryPicker.contains(event.target as Node)) setCategoryMenuOpen(false);
        if (localePicker && !localePicker.contains(event.target as Node)) setLocaleMenuOpen(false);
      });
      categoryPicker?.addEventListener('focusout', () => requestAnimationFrame(() => {
        if (!categoryPicker.contains(document.activeElement)) setCategoryMenuOpen(false);
      }));
      localePicker?.addEventListener('focusout', () => requestAnimationFrame(() => {
        if (!localePicker.contains(document.activeElement)) setLocaleMenuOpen(false);
      }));

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && !showcaseDialog?.open) setMenuOpen(false, true);
        if (event.key === '/' && document.activeElement !== searchInput && !['INPUT', 'TEXTAREA', 'SELECT'].includes((document.activeElement as HTMLElement | null)?.tagName ?? '')) {
          event.preventDefault();
          searchInput?.focus();
        }
      });

      const closeShowcaseDialog = () => showcaseDialog?.close();

      const setOriginalPostExpanded = (expanded: boolean) => {
        if (!dialogPostSection || !dialogPostToggle) return;
        dialogPostSection.toggleAttribute('data-expanded', expanded);
        dialogPostToggle.setAttribute('aria-expanded', String(expanded));
        dialogPostToggle.textContent = expanded
          ? (dialogPostToggle.dataset.collapseLabel ?? 'Collapse')
          : (dialogPostToggle.dataset.expandLabel ?? 'Expand');
      };

      dialogPostToggle?.addEventListener('click', () => {
        setOriginalPostExpanded(dialogPostToggle.getAttribute('aria-expanded') !== 'true');
      });

      const openShowcaseDialog = (data: ShowcaseDialogData) => {
        if (!showcaseDialog || !dialogVideo) return;
        activeDialogId = data.id;
        if (dialogTitle) dialogTitle.textContent = data.title;
        if (dialogDescription) dialogDescription.textContent = data.description;
        if (dialogPostText) dialogPostText.textContent = data.postText;
        setOriginalPostExpanded(false);
        if (dialogCategory) dialogCategory.textContent = data.categoryLabel;
        if (dialogLanguage) dialogLanguage.textContent = data.languageLabel;
        if (dialogCreator) {
          dialogCreator.textContent = `@${data.creatorHandle}`;
          dialogCreator.title = data.creatorName;
        }
        if (dialogDate) {
          dialogDate.dateTime = data.publishedAt;
          dialogDate.textContent = data.dateLabel;
        }
        if (dialogDuration) dialogDuration.textContent = data.durationLabel;
        if (dialogResolution) dialogResolution.textContent = data.resolutionLabel;
        if (dialogSource) dialogSource.href = data.sourceUrl;
        if (dialogError) dialogError.hidden = true;
        const visibleCardCount = getCards().length;
        dialogNavButtons.forEach((button) => { button.disabled = visibleCardCount < 2; });

        dialogVideo.pause();
        dialogVideo.poster = data.posterUrl;
        dialogVideo.src = data.videoUrl;
        showcaseDialog.showModal();
        document.body.classList.add('dialog-open');
        dialogVideo.load();
        void dialogVideo.play().catch(() => {});
      };

      const openCardDialog = (card: HTMLElement) => {
          const serializedData = card.dataset.dialog;
          if (!serializedData) return;
          try {
            openShowcaseDialog(JSON.parse(serializedData) as ShowcaseDialogData);
          } catch {
            card.setAttribute('aria-label', document.body.dataset.videoError ?? 'Video failed to load. Click to retry.');
          }
      };
      showcaseGrid?.addEventListener('click', (event) => {
        const card = (event.target as HTMLElement).closest<HTMLElement>('[data-showcase-card]');
        if (card) openCardDialog(card);
      });
      showcaseGrid?.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter' && event.key !== ' ') return;
        const card = (event.target as HTMLElement).closest<HTMLElement>('[data-showcase-card]');
        if (!card) return;
        event.preventDefault();
        openCardDialog(card);
      });
      dialogNavButtons.forEach((button) => button.addEventListener('click', () => {
        const direction = button.dataset.showcaseDialogNav;
        if (direction !== 'previous' && direction !== 'next') return;
        const visibleCards = getCards();
        const adjacentId = getAdjacentShowcaseId(
          visibleCards.map((card) => card.dataset.videoId ?? ''),
          activeDialogId,
          direction,
        );
        const adjacentCard = visibleCards.find((card) => card.dataset.videoId === adjacentId);
        if (adjacentCard) openCardDialog(adjacentCard);
      }));
      dialogClose?.addEventListener('click', closeShowcaseDialog);
      showcaseDialog?.addEventListener('click', (event) => {
        if (event.target === showcaseDialog) closeShowcaseDialog();
      });
      showcaseDialog?.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowLeft' && event.key !== 'ArrowRight') return;
        event.preventDefault();
        dialogNavButtons.find((button) => button.dataset.showcaseDialogNav === (event.key === 'ArrowLeft' ? 'previous' : 'next'))?.click();
      });
      showcaseDialog?.addEventListener('close', () => {
        activeDialogId = '';
        document.body.classList.remove('dialog-open');
        if (!dialogVideo) return;
        dialogVideo.pause();
        dialogVideo.removeAttribute('src');
        dialogVideo.removeAttribute('poster');
        dialogVideo.load();
      });
      dialogVideo?.addEventListener('loadeddata', () => {
        if (dialogError) dialogError.hidden = true;
      });
      dialogVideo?.addEventListener('error', () => {
        if (dialogError) dialogError.hidden = false;
      });

      if (emptyState) emptyState.hidden = getCards().length !== 0;
      syncSidebarAccess();
    </script>
  </body>
</html>

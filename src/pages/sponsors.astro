---
import '../styles/global.css';
import '../styles/sponsors.css';
import { ArrowUpRight, LockKeyhole, Minus, Plus } from '@lucide/astro';
import SiteLayout from '../components/SiteLayout.astro';
import { nextTopRankAmountUsd, rankedSponsors, sponsorRules } from '../data/sponsors';
import { defaultLocale, getLocale, localeConfig, locales, type Locale } from '../i18n';
import { getLocalePath } from '../i18n/config';

const base = import.meta.env.BASE_URL;
const locale = getLocale(Astro.props.locale ?? Astro.currentLocale);
const siteUrl = 'https://jevbest.com/';
const pagePath = `${getLocalePath(locale)}sponsors/`;
const pageUrl = `${siteUrl}${pagePath}`;
const returnPath = `/${pagePath}`;
const sponsorEndpoint = `${base}api/sponsors/`;
const checkoutAction = `${base}api/sponsors/checkout/`;


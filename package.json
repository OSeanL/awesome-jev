{
  "name": "awesome-jev-site",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "sync:dates": "node scripts/sync-added-at.mjs",
    "sync:changelog": "node scripts/sync-changelog.mjs",
    "check": "node scripts/sync-changelog.mjs --check && astro check",
    "test": "node --test tests/*.test.mjs",
    "build": "astro build",
    "preview": "astro build && wrangler dev",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply SPONSORS_DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply SPONSORS_DB --remote"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@lucide/astro": "^1.47.0",
    "astro": "7.3.3",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.4",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@types/node": "^24.5.2",
    "typescript": "^5.9.2",
    "wrangler": "^4.136.3"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
